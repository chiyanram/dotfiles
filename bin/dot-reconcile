#!/usr/bin/env bash
# Description: Report drift between the repo and this machine; prune, adopt, or ignore undeclared items.

set -Eeuo pipefail
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)
# DOTFILES is the *managed state* root (Brewfiles, toolchain, home/, config/);
# libs load from the script's own dir so a test can point DOTFILES at a fixture.
# Always self-locates unless DOT_TEST_DOTFILES is set (test-only escape hatch —
# never set by .zshenv, so an ambient DOTFILES can't silently redirect this).
# shellcheck disable=SC2034  # used by functions in the sourced reconcile.sh (e.g. reconcile_brew_adopt), not directly in this file
DOTFILES="${DOT_TEST_DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"

# source helpers — both libs are shellcheck'd directly by `dot test`, no need to follow
# shellcheck disable=SC1091
source "$script_dir/lib/common.sh"
# shellcheck disable=SC1091
source "$script_dir/lib/reconcile.sh"
command_name=$(basename "${BASH_SOURCE[0]}")

DOMAINS="brew sdkman plugins symlinks"

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_key "$command_name") $(fmt_value "[domain]")
         $(fmt_key "$command_name") $(fmt_value "<domain> --prune <names...> | --all")
         $(fmt_key "$command_name") $(fmt_value "<domain> --adopt <names...> | --all [--to core]")
         $(fmt_key "$command_name") $(fmt_value "<domain> --ignore <names...> | --all")
         $(fmt_key "$command_name") $(fmt_value "<domain> --unignore <names...> | --all")

  Report drift between the repo's declared state (Brewfiles, sdkman/toolchain,
  .zshrc plugins, config/home links) and what is actually on this machine.
  The report is read-only. Domains: $DOMAINS (default: all).

  --prune, --adopt, and --ignore resolve undeclared items of ONE domain (brew,
  sdkman, plugins — symlinks are dot clean / dot link's job): prune uninstalls
  them, adopt appends them to the declared file (Brewfile / toolchain /
  .zshrc) and leaves the edit UNCOMMITTED for review, ignore records them in a
  machine-local, never-committed file so they stop showing as undeclared (for
  one-off installs you don't want to uninstall OR declare). --unignore
  reverses --ignore. Only items the report lists as undeclared (or, for
  --unignore, ignored) qualify; anything declared (here or in another
  profile) is refused. The report is the preview: no names and no --all
  changes nothing.

Options:
    --prune <names...>     Remove the named undeclared items
    --adopt <names...>     Declare the named undeclared items (uncommitted edit)
    --ignore <names...>    Stop reporting the named undeclared items (machine-local)
    --unignore <names...>  Resume reporting the named ignored items
    --all                  Apply the action to every eligible item
    --to core              With brew --adopt: append to Brewfile.core instead of
                           the active profile's Brewfile
    -h, --help             Show this help message
EOF
}

# Print a report block: header + one indented line per input line; nothing when
# the input is empty. Usage: _section <color> <label> <hint> <<< "$lines"
_section() {
  local color="$1" label="$2" hint="$3" line printed=false
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if [ "$printed" = false ]; then
      # the hint embeds color vars (backslash-text) — %b, never %s
      printf "  %b%s%b%b\n" "$color" "$label" "$RESET" "${hint:+  ${DIM}${hint}${RESET}}"
      printed=true
    fi
    printf "    %s\n" "$line"
  done
}

report_brew() {
  fmt_title_underline "Homebrew"
  reconcile_brew_undeclared | _section "$YELLOW" "undeclared (installed, in no Brewfile)" ""
  reconcile_brew_missing | _section "$RED" "missing (declared, not installed)" "→ dot homebrew bundle"
  reconcile_brew_declared_elsewhere | _section "$DIM" "declared in another profile (informational)" ""
  reconcile_brew_ignored_active | _section "$DIM" "ignored (informational)" ""
}

report_sdkman() {
  fmt_title_underline "SDKMAN"
  reconcile_sdkman_undeclared | _section "$YELLOW" "undeclared (installed, not in toolchain)" ""
  reconcile_sdkman_missing | _section "$RED" "missing (declared, not installed)" "→ dot sdkman install"
  reconcile_sdkman_ignored_active | _section "$DIM" "ignored (informational)" ""
}

report_plugins() {
  fmt_title_underline "Zsh plugins"
  reconcile_plugins_undeclared | _section "$YELLOW" "undeclared (cloned, not in .zshrc)" ""
  reconcile_plugins_missing | _section "$RED" "missing (declared, not cloned)" "→ open a new shell (zfetch clones on startup)"
  reconcile_plugins_ignored_active | _section "$DIM" "ignored (informational)" ""
}

report_symlinks() {
  fmt_title_underline "Symlinks"
  reconcile_symlinks_dangling | sed "s|^$HOME|~|" |
    _section "$YELLOW" "dangling (source removed from repo)" "→ dot clean"
  reconcile_symlinks_missing | _section "$RED" "unhealthy (state + target)" "→ dot link (see: dot link --status)"
}

# Apply a resolve verb (prune | adopt | ignore | unignore) to the named (or
# all) eligible items of one domain. Every name is checked against the
# domain's eligible set — the ONLY gate between user input and an uninstall /
# declared-file edit / ignore-file edit, so a declared / declared-elsewhere /
# alias-declared name is refused, never touched. --unignore's eligible set is
# the domain's currently-ignored names (not undeclared — an ignored name is,
# by definition, excluded from undeclared); every other verb's eligible set is
# undeclared.
do_resolve() {
  local verb="$1" domain="$2" all="$3" names="$4" dest="${5:-}"
  case "$domain" in
    brew | sdkman | plugins) ;;
    symlinks)
      case "$verb" in
        prune) log_error "symlinks has no --prune — dangling links are removed by: dot clean" ;;
        adopt) log_error "symlinks has no --adopt — import live files with: dot link --adopt" ;;
        *) log_error "symlinks has no --$verb — link health has no ignore/unignore concept" ;;
      esac
      return 1
      ;;
    "")
      log_error "--$verb needs a domain: brew, sdkman, or plugins"
      return 1
      ;;
    *)
      log_error "Unknown domain: $domain (expected one of: $DOMAINS)"
      return 1
      ;;
  esac
  if [ -n "$dest" ] && { [ "$verb" != "adopt" ] || [ "$domain" != "brew" ]; }; then
    log_error "--to core only applies to: brew --adopt"
    return 1
  fi

  local eligible eligible_label="undeclared"
  if [ "$verb" = "unignore" ]; then
    eligible="$("reconcile_${domain}_ignored")"
    eligible_label="ignored"
  else
    eligible="$("reconcile_${domain}_undeclared")"
  fi
  if [ "$all" = true ]; then
    names="$eligible"
    if [ -z "$names" ]; then
      log_success "Nothing $eligible_label in $domain — nothing to $verb"
      return 0
    fi
  elif [ -z "$names" ]; then
    log_error "Nothing to $verb: pass names or --all (run $command_name $domain to preview)"
    return 1
  fi

  local name failed=0 done_label="pruned"
  case "$verb" in
    adopt) done_label="adopted" ;;
    ignore) done_label="ignored" ;;
    unignore) done_label="unignored" ;;
  esac
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if ! printf '%s\n' "$eligible" | grep -qxF "$name"; then
      if [ "$verb" = "unignore" ]; then
        log_error "refusing to unignore $name — not currently ignored in $domain"
      else
        log_error "refusing to $verb $name — not undeclared in $domain (declared here or in another profile, or not installed)"
      fi
      failed=1
      continue
    fi
    if "reconcile_${domain}_${verb}" "$name" ${dest:+"$dest"}; then
      log_success "$done_label $name"
    else
      log_error "failed to $verb $name"
      failed=1
    fi
  done <<<"$names"

  if [ "$verb" = "adopt" ] && [ "$failed" -eq 0 ]; then
    log_info "adopted entries are left uncommitted — review the diff, describe the placeholder comments, and commit"
  fi
  return "$failed"
}

report() {
  local scope="$1" domain matched=false
  for domain in $DOMAINS; do
    if [ -z "$scope" ] || [ "$scope" = "$domain" ]; then
      "report_$domain"
      matched=true
    fi
  done
  if [ "$matched" = false ]; then
    log_error "Unknown domain: $scope (expected one of: $DOMAINS)"
    echo
    usage
    exit 1
  fi

  echo
  local summary
  summary="$(reconcile_summary)"
  if [ -n "$summary" ]; then
    log_warning "Drift found — resolve with the hints above, or: $command_name <domain> --prune / --adopt / --ignore"
  else
    log_success "No drift — this machine matches the repo's declared state"
  fi
}

main() {
  # Grammar: [domain] [--prune|--adopt|--ignore|--unignore [names... | --all]]
  # [--to core] — the first positional is the domain; positionals after the
  # verb are names (newline-joined, not an array: "${arr[@]}" on an empty
  # array trips set -u under bash 3.2).
  local scope="" verb="" all=false names="" dest=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      --prune | --adopt | --ignore | --unignore)
        if [ -n "$verb" ]; then
          log_error "--prune, --adopt, --ignore, and --unignore are mutually exclusive"
          exit 1
        fi
        verb="${1#--}"
        ;;
      --all) all=true ;;
      --to)
        shift
        dest="${1:-}"
        if [ "$dest" != "core" ]; then
          log_error "--to only supports: core"
          exit 1
        fi
        ;;
      -*)
        log_error "Unknown option: $1"
        echo
        usage
        exit 1
        ;;
      *)
        if [ -n "$verb" ]; then
          names="${names}${1}"$'\n'
        elif [ -z "$scope" ]; then
          scope="$1"
        else
          log_error "Unexpected argument: $1 (one domain at a time)"
          exit 1
        fi
        ;;
    esac
    shift
  done

  if [ "$all" = true ] && [ -z "$verb" ]; then
    log_error "--all only makes sense with --prune, --adopt, --ignore, or --unignore"
    exit 1
  fi
  if [ -n "$dest" ] && [ -z "$verb" ]; then
    log_error "--to core only applies to: brew --adopt"
    exit 1
  fi

  if [ -n "$verb" ]; then
    do_resolve "$verb" "$scope" "$all" "$names" "$dest"
    return
  fi
  report "$scope"
}

# Only run main when executed directly (sourcing for tests must not report).
if [[ "${BASH_SOURCE[0]:-$0}" == "${0}" ]]; then main "$@"; fi
