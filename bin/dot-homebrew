#!/usr/bin/env bash
# Description: Setup and configure Homebrew.

set -Eeuo pipefail
DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"

# source helpers
source "$DOTFILES/bin/lib/common.sh"
command_name=$(basename "${BASH_SOURCE[0]}")

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_key "$command_name") $(fmt_value "[options] <command>")

  Setup and configure Homebrew. This script automates the installation of Homebrew on
  macOS and Linux. It also installs Homebrew packages from the brew/Brewfile.* bundles
  in the dotfiles repository.


Options:
    -h, --help       Show this help message
    install          Install Homebrew on this machine
    bundle           Install Homebrew packages (auto-trusts taps with packages
                     installed from them; warns about unused untrusted taps)
EOF
}

homebrew_install() {
  fmt_title_underline "Setting up Homebrew"

  if test "$(command -v brew)"; then
    log_info "Homebrew already installed."
    exit 0
  fi

  # Fetch the installer, then run it via `bash -c` so its stdin stays the TTY: a
  # fresh Mac's Homebrew install needs an interactive sudo password, which a
  # `curl | bash` pipe can't supply (stdin becomes the pipe, not the terminal).
  # --connect-timeout/--retry fail fast on a blocked/flaky network (curl honors
  # HTTPS_PROXY); the empty-check stops a failed download from silently passing.
  local installer
  if ! installer="$(curl -fsSL --connect-timeout 10 --retry 2 \
    https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || [[ -z "$installer" ]]; then
    log_error "Homebrew installer download failed (network/proxy?). Set HTTPS_PROXY or install manually: https://brew.sh"
    return 1
  fi
  if ! /bin/bash -c "$installer"; then
    log_error "Homebrew install failed — it needs an admin (sudo) password; re-run in a terminal, or install manually: https://brew.sh"
    return 1
  fi

  log_success "Homebrew installed successfully."

  if [ "$(uname)" == "Linux" ]; then
    log_info "Setting up Linuxbrew-specific files."
    test -d ~/.linuxbrew && eval "$(~/.linuxbrew/bin/brew shellenv)"
    test -d /home/linuxbrew/.linuxbrew && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    test -r ~/.bash_profile && echo "eval \$($(brew --prefix)/bin/brew shellenv)" >>~/.bash_profile
  fi
}

# True when any installed keg or cask records $1 as its source tap in an
# INSTALL_RECEIPT.json ($2 = cellar dir, $3 = caskroom dir). Unmatched globs
# stay literal; -s keeps grep quiet about the resulting missing files.
homebrew_tap_in_use() {
  local tap="$1" cellar="$2" caskroom="$3"
  grep -qs "\"tap\"[[:space:]]*:[[:space:]]*\"$tap\"" \
    "$cellar"/*/*/INSTALL_RECEIPT.json \
    "$caskroom"/*/.metadata/INSTALL_RECEIPT.json
}

# Homebrew 6 enforces tap-trust: formulae/casks from untrusted third-party taps
# refuse to load, which hard-fails `brew bundle` even for a core-only Brewfile
# when resolution touches a tap formula (#17: tenv -> hashicorp/tap/terraform).
# Policy: auto-trust only taps with packages installed from them (revealed
# dependence); warn about the rest. Fresh machine has no taps -> no-op.
# Never fails the bundle step.
homebrew_trust_taps() {
  # Pre-tap-trust Homebrew (< 6) has no `trust` command — nothing to do.
  if ! brew trust --json=v1 >/dev/null 2>&1; then
    return 0
  fi

  local cellar caskroom tap info
  cellar="$(brew --cellar 2>/dev/null)" || cellar=""
  caskroom="$(brew --caskroom 2>/dev/null)" || caskroom=""

  while IFS= read -r tap; do
    [[ -z "$tap" ]] && continue
    case "$tap" in homebrew/*) continue ;; esac # official taps are implicitly trusted
    # tap-info prints a bare Trusted/Untrusted line while trust is enforced.
    info="$(brew tap-info "$tap" 2>/dev/null)" || info=""
    grep -qx "Untrusted" <<<"$info" || continue
    if homebrew_tap_in_use "$tap" "$cellar" "$caskroom"; then
      log_info "Trusting tap $tap (packages installed from it)"
      brew trust --tap "$tap" ||
        log_warning "Could not trust $tap — bundle may fail (try: brew trust --tap $tap)"
    else
      log_warning "Untrusted tap $tap has nothing installed from it — leaving it untrusted. Trust it (brew trust --tap $tap) or remove it (brew untap $tap)."
    fi
  done < <(brew tap 2>/dev/null)
  return 0
}

homebrew_bundle() {
  if ! command -v brew &>/dev/null; then
    log_error "Homebrew is not installed. Exiting."
    return 1
  fi

  fmt_title_underline "Installing Homebrew packages (profile: $(dot_profile))"

  homebrew_trust_taps

  local bf
  # shellcheck disable=SC2119  # dot_brewfiles takes an optional profile arg; calling with no arg is intentional
  while IFS= read -r bf; do
    log_info "Bundling ${bf##*/}"
    if ! brew bundle --file="$bf"; then
      log_error "Failed bundling $bf"
      return 1
    fi
  done < <(dot_brewfiles)

  # Docker runtime — profile default, overridable via the docker_runtime config key.
  local runtime entries
  runtime="$(dot_docker_runtime)"
  if entries="$(dot_docker_runtime_entries "$runtime")"; then
    log_info "Docker runtime: $runtime"
    if ! brew bundle --file=<(printf '%s\n' "$entries"); then
      log_error "Failed installing Docker runtime: $runtime"
      return 1
    fi
  else
    log_warning "Unknown docker_runtime '$runtime' — skipping (set with: dot profile set-config docker_runtime <docker-desktop|rancher|colima>)"
  fi

  log_success "Homebrew packages installed successfully."

  # install fzf key bindings (only on first run)
  local fzf_install
  fzf_install="$(brew --prefix)/opt/fzf/install"
  if [[ -x "$fzf_install" ]] && [[ ! -f "$HOME/.fzf.zsh" ]]; then
    echo -e
    log_info "Installing fzf key bindings"
    "$fzf_install" --key-bindings --completion --no-update-rc --no-bash --no-fish
  fi
}

main() {
  local subcmd=""

  if [ $# -lt 1 ]; then
    usage
    exit 0
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      *)
        subcmd="$1"
        shift
        ;;
    esac
  done

  case "$subcmd" in
    install)
      homebrew_install
      ;;
    bundle)
      homebrew_bundle
      ;;
    *)
      log_error "Unknown legacy command: $subcmd"
      echo -e
      usage
      exit 1
      ;;
  esac
}

main "$@"
