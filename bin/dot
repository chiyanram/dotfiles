#!/usr/bin/env bash

set -Eeuo pipefail
trap cleanup SIGINT SIGTERM ERR EXIT

cleanup() {
  trap - SIGINT SIGTERM ERR EXIT
  if [[ -t 1 ]]; then tput cnorm 2>/dev/null || true; fi # enable cursor only when stdout is a tty
  # script cleanup here
}

command_name=$(basename "${BASH_SOURCE[0]}")
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)
DOTFILES="${DOTFILES:-$(cd "$script_dir/.." && pwd -P)}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dot"

if [[ -f "$DOTFILES/bin/lib/common.sh" ]]; then
  source "$DOTFILES/bin/lib/common.sh"
else
  echo "Error: Unable to source common.sh"
  exit 1
fi

find_commands() {
  IFS=: read -ra path_dirs <<<"$PATH"
  # Include script_dir so external commands are discoverable before bin/ is in PATH
  path_dirs+=("$script_dir")
  for dir in "${path_dirs[@]}"; do
    # skip if the directory doesn't exist or isn't readable
    [[ ! -d "$dir" ]] && continue
    for cmd in "$dir"/dot-*; do
      [[ -f "$cmd" && -x "$cmd" ]] || continue
      basename "$cmd" | sed 's/^dot-//'
    done
  done | sort -u
}

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_cmd "$command_name") $(fmt_value "<command> [subcommand] [options]")

Dotfiles management script.

$(fmt_key "Available Commands:")
    help                          Show this help message
    clean                         Clean up broken symlinks
    backup                        Backup dotfiles
        -d, --directory <dir>   Backup directory (default: ~/dotfiles-backup)
    link                          Link dotfiles packages to their respective locations
        all                       Link all
        <pkg>                     Link a specific package
        clean                     Clean up broken symlinks
            -n, --dry-run         Show what would be removed without actually removing
            -v, --verbose         Show detailed output
        -f, --force               Replace existing symlinks (refuses to overwrite real files)
        -n, --dry-run             Preview the plan (CREATE/SKIP/REPLACE/CONFLICT); non-zero on conflict
        --status                  Show link status without making changes
        -v, --verbose             Show detailed output
    unlink                        Unlink dotfiles packages
        all                       Unlink all
        <pkg>                     Unlink a specific package
        -v, --verbose             Show detailed output
    restore                       Undo the last 'dot link' run (removes/repoints created symlinks)
        [manifest]                Restore a specific manifest instead of the newest
EOF

  echo -e "\nExternal commands:"

  find_commands | while read -r cmd; do
    # Get the description from the script if available
    description=$(grep "^# Description:" "$(which "dot-$cmd")" 2>/dev/null | cut -d: -f2- | sed 's/^[[:space:]]*//' || echo "No description available")
    printf "    $(fmt_cmd "%-12s") %s\n" "$cmd" "$description"
  done
}

cmd_clean() {
  fmt_title_underline "Cleaning up broken legacy symlinks..."

  # Clean broken config symlinks (derived from config/ directory)
  for config in "$DOTFILES/config"/*; do
    [[ -d "$config" ]] || continue
    # skip empty config packages (nothing to link)
    [[ -n "$(ls -A "$config" 2>/dev/null)" ]] || continue
    local target
    target="$CONFIG_HOME/$(basename "$config")"
    if [ -L "$target" ] && [ ! -e "$target" ]; then
      log_info "Removing broken symbolic link: ~${target#"$HOME"}"
      rm "$target"
    fi
  done

  # Clean stale symlinks pointing to deleted dotfiles config dirs
  if [ -d "$CONFIG_HOME" ]; then
    while IFS= read -r -d '' link; do
      if [ -L "$link" ] && [ ! -e "$link" ]; then
        local link_target
        link_target=$(readlink "$link")
        if [[ "$link_target" == "$DOTFILES"* ]]; then
          log_info "Removing stale symbolic link: ~${link#"$HOME"} → $link_target"
          rm "$link"
        fi
      fi
    done < <(find "$CONFIG_HOME" -maxdepth 1 -type l -print0 2>/dev/null || true)
  fi

  # Clean broken home directory symlinks
  if [ -d "$DOTFILES/home" ]; then
    while IFS= read -r -d '' file; do
      relative_path="${file#"$DOTFILES"/home/}"
      target_path="$HOME/$relative_path"
      if [ -L "$target_path" ] && [ ! -e "$target_path" ]; then
        log_info "Removing broken symbolic link: ~${target_path#"$HOME"}"
        rm "$target_path"
      fi
    done < <(find "$DOTFILES/home" -type f -print0)
  fi

  echo
  log_success "Done."
}

cmd_backup() {
  local backup_dir="$HOME/dotfiles-backup"
  local verbose=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d | --directory)
        if [[ -n "${2:-}" ]]; then
          backup_dir="$2"
          shift 2
        else
          log_error "Missing backup directory"
          return 1
        fi
        ;;
      -v | --verbose)
        verbose=true
        shift
        ;;
      *)
        log_error "Unknown argument: $1"
        return 1
        ;;
    esac
  done

  # Expand ~ in backup_dir
  backup_dir="${backup_dir/#\~/$HOME}"

  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local backup_path="${backup_dir}/dotfiles_backup_${timestamp}"

  log_info "Creating backup in: $backup_path"

  # Derive backup list from config/ directory (single source of truth)
  files_to_backup=()
  for config in "$DOTFILES/config"/*; do
    [[ -d "$config" ]] || continue
    # skip empty config packages (nothing to link)
    [[ -n "$(ls -A "$config" 2>/dev/null)" ]] || continue
    files_to_backup+=(".config/$(basename "$config")")
  done

  # Add home directory files to backup
  if [ -d "$DOTFILES/home" ]; then
    while IFS= read -r -d '' file; do
      relative_path="${file#"$DOTFILES"/home/}"
      files_to_backup+=("$relative_path")
    done < <(find "$DOTFILES/home" -type f -print0)
  fi

  tmpfile=$(mktemp)

  for file in "${files_to_backup[@]}"; do
    src_path="${HOME}/${file}"
    if [[ -L "$src_path" ]]; then
      [[ "$verbose" == true ]] && log_info "Skipping symlink: $file"
      continue
    elif [[ -e "$src_path" ]]; then
      echo "$file" >>"$tmpfile"
      [[ "$verbose" == true ]] && log_info "Found: $file"
    else
      log_warning "File not found: $src_path"
    fi
  done

  if [[ -s "$tmpfile" ]]; then
    mkdir -p "$backup_dir"
    if ! tar -czf "${backup_path}.tar.gz" -C "$HOME" -T "$tmpfile"; then
      log_error "Failed to create backup archive"
      rm -f "$tmpfile"
      return 1
    fi

    if [[ "$verbose" == true ]]; then
      log_info "Archive contents:"
      tar -tvf "${backup_path}.tar.gz" | while read -r line; do
        log_info "$line"
      done
    fi

    log_success "Backup created successfully"
  else
    log_warning "No files to backup"
  fi

  rm -f "$tmpfile"
}

link_home_files() {
  local operation="$1"
  local verbose="$2"
  local force="${3:-false}"

  if [ ! -d "$DOTFILES/home" ]; then
    return 0
  fi

  while IFS= read -r -d '' file; do
    local relative_path="${file#"$DOTFILES"/home/}"
    local target_path="$HOME/$relative_path"
    local target_dir
    target_dir="$(dirname "$target_path")"

    if [ "$operation" = "link" ]; then
      # Create parent directories if needed
      if [ ! -d "$target_dir" ]; then
        [ "$verbose" = true ] && log_info "Creating directory: $target_dir"
        mkdir -p "$target_dir"
      fi

      if [ "$force" = true ] && [ -e "$target_path" ]; then
        if [ -L "$target_path" ]; then
          [ "$verbose" = true ] && log_info "Replacing symlink: ~${target_path#"$HOME"}"
          rm "$target_path"
          ln -s "$file" "$target_path"
        else
          log_warning "~${target_path#"$HOME"} is a real file, not a symlink. Skipping (backup first with: dot backup)"
        fi
      elif [ -e "$target_path" ]; then
        log_warning "~${target_path#"$HOME"} already exists... Skipping."
      else
        [ "$verbose" = true ] && log_info "Linking $relative_path"
        ln -s "$file" "$target_path"
      fi
    else # unlink
      if [ -L "$target_path" ]; then
        [ "$verbose" = true ] && log_info "Unlinking $target_path"
        rm "$target_path"
      elif [ -e "$target_path" ]; then
        log_warning "Skipping \"$target_path\" because it is not a symlink"
      fi
    fi
  done < <(find "$DOTFILES/home" -type f -print0)
}

cmd_link_clean() {
  local verbose=false
  local dry_run=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v | --verbose)
        verbose=true
        shift
        ;;
      -n | --dry-run)
        dry_run=true
        shift
        ;;
      *)
        log_error "Unknown argument: $1"
        exit 1
        ;;
    esac
  done

  fmt_title_underline "Cleaning up broken symlinks"

  local broken_count=0

  # Check config directory symlinks
  if [ -d "$CONFIG_HOME" ]; then
    while IFS= read -r -d '' link; do
      if [ -L "$link" ] && [ ! -e "$link" ]; then
        broken_count=$((broken_count + 1))
        if [ "$dry_run" = true ]; then
          log_warning "[DRY RUN] Would remove broken symlink: ~${link#"$HOME"}"
        else
          [ "$verbose" = true ] && log_info "Removing broken symlink: ~${link#"$HOME"}"
          rm "$link"
        fi
      fi
    done < <(find "$CONFIG_HOME" -type l -print0 2>/dev/null || true)
  fi

  # Check home directory symlinks created from $DOTFILES/home
  if [ -d "$DOTFILES/home" ]; then
    # Get all directories that contain files in $DOTFILES/home
    local home_dirs=()
    while IFS= read -r -d '' file; do
      local dir_path
      dir_path="$HOME/$(dirname "${file#"$DOTFILES"/home/}")"
      # Add to array if not already present
      local found=0
      local d
      for d in "${home_dirs[@]+"${home_dirs[@]}"}"; do
        [[ "$d" == "$dir_path" ]] && found=1 && break
      done
      [[ "$found" -eq 0 ]] && home_dirs+=("$dir_path")
    done < <(find "$DOTFILES/home" -type f -print0)

    # Now check for broken symlinks only in those directories
    for dir in "${home_dirs[@]}"; do
      if [ -d "$dir" ]; then
        while IFS= read -r -d '' link; do
          if [ -L "$link" ] && [ ! -e "$link" ]; then
            # Check if this broken symlink points to our dotfiles directory
            local link_target
            link_target=$(readlink "$link")
            if [[ "$link_target" == "$DOTFILES"* ]]; then
              broken_count=$((broken_count + 1))
              if [ "$dry_run" = true ]; then
                log_warning "[DRY RUN] Would remove broken symlink: ~${link#"$HOME"}"
              else
                [ "$verbose" = true ] && log_info "Removing broken symlink: ~${link#"$HOME"}"
                rm "$link"
              fi
            fi
          fi
        done < <(find "$dir" -maxdepth 1 -type l -print0 2>/dev/null || true)
      fi
    done
  fi

  echo
  if [ "$broken_count" -eq 0 ]; then
    log_success "No broken symlinks found"
  else
    if [ "$dry_run" = true ]; then
      log_info "Found $broken_count broken symlink(s). Run without --dry-run to remove them."
    else
      log_success "Removed $broken_count broken symlink(s)"
    fi
  fi
}

classify_link() {
  local source="$1"
  local target="$2"
  if [ -L "$target" ]; then
    local actual
    actual=$(readlink "$target")
    if [ "$actual" = "$source" ]; then
      echo "ok"
    else
      echo "wrong"
    fi
  elif [ -e "$target" ]; then
    echo "real"
  else
    echo "missing"
  fi
}

link_status() {
  fmt_title_underline "Link Status"

  local ok=0 missing=0 wrong=0 real=0

  # Config packages
  for config in "$DOTFILES/config"/*; do
    [[ -d "$config" ]] || continue
    # skip empty config packages (nothing to link)
    [[ -n "$(ls -A "$config" 2>/dev/null)" ]] || continue
    local name target state
    name=$(basename "$config")
    target="$CONFIG_HOME/$name"
    state=$(classify_link "$config" "$target")
    # shellcheck disable=SC2088  # tilde is intentional display label, not expansion
    case "$state" in
      ok)
        printf "  %b%-22s%b %b%s%b\n" "$GREEN" "[OK]" "$RESET" "$DIM" "~/.config/$name" "$RESET"
        ok=$((ok + 1))
        ;;
      wrong)
        printf "  %b%-22s%b %s → %s\n" "$YELLOW" "[WRONG]" "$RESET" "~/.config/$name" "$(readlink "$target")"
        wrong=$((wrong + 1))
        ;;
      real)
        printf "  %b%-22s%b %s (real file/dir)\n" "$RED" "[REAL]" "$RESET" "~/.config/$name"
        real=$((real + 1))
        ;;
      missing)
        printf "  %b%-22s%b %s\n" "$RED" "[MISSING]" "$RESET" "~/.config/$name"
        missing=$((missing + 1))
        ;;
    esac
  done

  # Home files
  if [ -d "$DOTFILES/home" ]; then
    while IFS= read -r -d '' file; do
      local relative_path target_path state
      relative_path="${file#"$DOTFILES"/home/}"
      target_path="$HOME/$relative_path"
      state=$(classify_link "$file" "$target_path")
      # shellcheck disable=SC2088  # tilde is intentional display label, not expansion
      case "$state" in
        ok)
          printf "  %b%-22s%b %b%s%b\n" "$GREEN" "[OK]" "$RESET" "$DIM" "~/$relative_path" "$RESET"
          ok=$((ok + 1))
          ;;
        wrong)
          printf "  %b%-22s%b %s → %s\n" "$YELLOW" "[WRONG]" "$RESET" "~/$relative_path" "$(readlink "$target_path")"
          wrong=$((wrong + 1))
          ;;
        real)
          printf "  %b%-22s%b %s (real file)\n" "$RED" "[REAL]" "$RESET" "~/$relative_path"
          real=$((real + 1))
          ;;
        missing)
          printf "  %b%-22s%b %s\n" "$RED" "[MISSING]" "$RESET" "~/$relative_path"
          missing=$((missing + 1))
          ;;
      esac
    done < <(find "$DOTFILES/home" -type f -print0)
  fi

  echo
  printf "  %b%d ok%b  %b%d missing%b  %b%d wrong%b  %b%d real%b\n" \
    "$GREEN" "$ok" "$RESET" "$RED" "$missing" "$RESET" "$YELLOW" "$wrong" "$RESET" "$RED" "$real" "$RESET"
}

# Emit "<source>\t<target>\t<label>" for every managed target: config packages
# (config/<pkg> → ~/.config/<pkg>) and home files (home/<rel> → ~/<rel>). Single
# source of truth for "what dot link manages", so the plan and the action agree.
managed_targets() {
  local config name file rel
  for config in "$DOTFILES/config"/*; do
    [ -d "$config" ] || continue
    # skip empty config packages (nothing to link)
    [[ -n "$(ls -A "$config" 2>/dev/null)" ]] || continue
    name=$(basename "$config")
    printf '%s\t%s\t~/.config/%s\n' "$config" "$CONFIG_HOME/$name" "$name"
  done
  [ -d "$DOTFILES/home" ] || return 0
  while IFS= read -r -d '' file; do
    rel="${file#"$DOTFILES"/home/}"
    printf '%s\t%s\t~/%s\n' "$file" "$HOME/$rel" "$rel"
  done < <(find "$DOTFILES/home" -type f -print0)
}

# link_plan — preview what `dot link all` would do, classifying each managed
# target via classify_link. Never mutates the filesystem. Two-phase gate: it
# scans everything, then returns non-zero if any CONFLICT (a real file/dir in the
# way) so a caller/CI can refuse before a real run.
link_plan() {
  local verbose="${1:-false}"
  fmt_title_underline "Link plan (dry run)"

  local source target label state ccolor
  local creates=0 skips=0 replaces=0 conflicts=0
  while IFS=$'\t' read -r source target label; do
    state=$(classify_link "$source" "$target")
    # shellcheck disable=SC2088  # tilde is a display label, not expansion
    case "$state" in
      missing)
        printf "  %b%-9s%b %s\n" "$GREEN" "CREATE" "$RESET" "$label"
        creates=$((creates + 1))
        ;;
      ok)
        printf "  %b%-9s%b %b%s%b\n" "$DIM" "SKIP" "$RESET" "$DIM" "$label" "$RESET"
        skips=$((skips + 1))
        ;;
      wrong)
        printf "  %b%-9s%b %s → %s\n" "$YELLOW" "REPLACE" "$RESET" "$label" "$(readlink "$target")"
        replaces=$((replaces + 1))
        ;;
      real)
        printf "  %b%-9s%b %s (real file/dir in the way)\n" "$RED" "CONFLICT" "$RESET" "$label"
        conflicts=$((conflicts + 1))
        # With -v, show the content delta (live vs repo) for regular files.
        if [ "$verbose" = true ] && [ -f "$source" ] && [ -f "$target" ]; then
          diff -u "$target" "$source" | sed 's/^/      /' || true
        fi
        ;;
    esac
  done < <(managed_targets)

  ccolor="$DIM"
  [ "$conflicts" -gt 0 ] && ccolor="$RED"
  echo
  printf "  %b%d create%b · %b%d skip%b · %b%d replace%b · %b%d conflict%b\n" \
    "$GREEN" "$creates" "$RESET" "$DIM" "$skips" "$RESET" \
    "$YELLOW" "$replaces" "$RESET" "$ccolor" "$conflicts" "$RESET"
  [ "$conflicts" -gt 0 ] && log_warning "Conflicts block a real run — back up or remove the real files first (dot backup)"
  [ "$conflicts" -eq 0 ]
}

# link_apply <source> <target> <label> <verbose> <force> — perform the action the
# plan previews, deciding via the SAME classify_link the plan uses so `dot link`
# and `dot link -n` can never disagree. Creates parent dirs as needed.
# Append an undo record to the current run's manifest (if one is active). Row:
# "<action>\t<target>\t<prev>" — prev is what restore sets <target> back to
# (empty = remove). No-op when DOT_MANIFEST is unset (e.g. single-package link).
manifest_record() {
  [ -n "${DOT_MANIFEST:-}" ] || return 0
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >>"$DOT_MANIFEST"
}

link_apply() {
  local source="$1" target="$2" label="$3" verbose="$4" force="$5"
  local target_dir
  target_dir="$(dirname "$target")"
  if [ ! -d "$target_dir" ]; then
    [ "$verbose" = true ] && log_info "Creating directory: $target_dir"
    mkdir -p "$target_dir"
  fi
  # shellcheck disable=SC2088  # tilde in labels is display, not expansion
  case "$(classify_link "$source" "$target")" in
    missing)
      [ "$verbose" = true ] && log_info "CREATE  $label"
      ln -s "$source" "$target"
      manifest_record "create" "$target" ""
      ;;
    ok)
      # Use `if`, not `&&`: a bare failing test here would make link_apply return
      # non-zero and trip `set -e` in the caller's loop on an all-SKIP re-run.
      if [ "$verbose" = true ]; then
        log_info "SKIP    $label (already linked)"
      fi
      ;;
    wrong)
      if [ "$force" = true ]; then
        [ "$verbose" = true ] && log_info "REPLACE $label → $source"
        local prev
        prev="$(readlink "$target")"
        rm "$target"
        ln -s "$source" "$target"
        manifest_record "replace" "$target" "$prev"
      else
        log_warning "$label points elsewhere ($(readlink "$target")) — rerun with -f to replace"
      fi
      ;;
    real)
      log_warning "$label is a real file/dir, not a symlink — skipping (back up first: dot backup)"
      ;;
  esac
}

link_config() {
  local config="$1" target="$2" verbose="$3" force="$4"
  local name
  name=$(basename "$config")

  if [ "$force" = true ] && [ -e "$target" ]; then
    if [ -L "$target" ]; then
      [ "$verbose" = true ] && log_info "Replacing symlink: ~${target#"$HOME"}"
      rm "$target"
      ln -s "$config" "$target"
    else
      log_warning "~${target#"$HOME"} is a real file/directory, not a symlink. Skipping (backup first with: dot backup)"
    fi
  elif [ -e "$target" ]; then
    log_warning "~${target#"$HOME"} already exists... Skipping."
  else
    [ "$verbose" = true ] && log_info "Linking $name"
    ln -s "$config" "$target"
  fi
}

cmd_link() {
  local operation="$1"
  local pkg="$2"
  shift 2 || true

  # Handle 'dot link clean' syntax
  if [ "$operation" = "link" ] && [ "$pkg" = "clean" ]; then
    cmd_link_clean "$@"
    return
  fi

  # Handle 'dot link --status' (no pkg required)
  if [ "$operation" = "link" ] && [ "$pkg" = "--status" ]; then
    link_status
    return
  fi

  local verbose=false
  local force=false
  local dry_run=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v | --verbose)
        verbose=true
        shift
        ;;
      -f | --force)
        force=true
        shift
        ;;
      --status)
        link_status
        return
        ;;
      -n | --dry-run)
        dry_run=true
        shift
        ;;
      *)
        log_error "Unknown argument: $1"
        exit 1
        ;;
    esac
  done

  # Preview the plan and stop — never mutates. Non-zero exit if any conflict.
  if [ "$dry_run" = true ]; then
    if [ "$operation" != "link" ]; then
      log_error "--dry-run is only supported for 'dot link'"
      exit 1
    fi
    link_plan "$verbose"
    return $?
  fi

  local title_text
  if [ "$pkg" = "all" ]; then
    title_text="${operation}ing all packages"
  else
    title_text="${operation}ing package: $pkg"
  fi

  fmt_title_underline "$title_text"

  if [ "$pkg" = "all" ]; then
    if [ "$operation" = "link" ]; then
      # Record every mutation to a per-run manifest so `dot restore` can undo it.
      mkdir -p "$STATE_DIR"
      DOT_MANIFEST="$STATE_DIR/manifest-$(date +%Y%m%d_%H%M%S)-$$.tsv"
      # Link every managed target via the SAME walk + classifier the plan uses,
      # so `dot link all` and `dot link all -n` can never disagree.
      local source target label
      while IFS=$'\t' read -r source target label; do
        link_apply "$source" "$target" "$label" "$verbose" "$force"
      done < <(managed_targets)
      # Drop an empty manifest (a no-op re-run changed nothing to undo).
      if [ -s "$DOT_MANIFEST" ]; then
        log_info "Recorded $(wc -l <"$DOT_MANIFEST" | tr -d ' ') change(s) — undo with: dot restore"
      else
        rm -f "$DOT_MANIFEST"
      fi
      unset DOT_MANIFEST
    else # unlink
      for config in "$DOTFILES/config"/*; do
        if [ -d "$config" ]; then
          # skip empty config packages (nothing to link)
          [[ -n "$(ls -A "$config" 2>/dev/null)" ]] || continue
          local target
          target="$CONFIG_HOME/$(basename "$config")"
          if [ -L "$target" ]; then
            [ "$verbose" = true ] && log_info "Unlinking $target"
            rm "$target"
          elif [ -e "$target" ]; then
            log_warning "Skipping \"$target\" because it is not a symlink"
          fi
        fi
      done
      link_home_files "unlink" "$verbose" "$force"
    fi
  else
    # Handle specific package
    local target="$CONFIG_HOME/$pkg"
    if [ -d "$DOTFILES/config/$pkg" ]; then
      # skip empty config packages (nothing to link)
      if [[ -z "$(ls -A "$DOTFILES/config/$pkg" 2>/dev/null)" ]]; then
        log_warning "Package $pkg is empty, skipping"
        return 0
      fi
      if [ "$operation" = "link" ]; then
        link_config "$DOTFILES/config/$pkg" "$target" "$verbose" "$force"
      else # unlink
        if [ -L "$target" ]; then
          [ "$verbose" = true ] && log_info "Unlinking $target"
          rm "$target"
        elif [ -e "$target" ]; then
          log_warning "Skipping \"$target\" because it is not a symlink"
        fi
      fi
    else
      log_error "Package $pkg not found in config directory"
      return 1
    fi
  fi

  echo -e
  log_success "Done"
}

# Undo a `dot link` run from its manifest (newest, or an explicit file). Reverses
# each recorded mutation: a created symlink is removed; a replaced one is repointed
# to its previous target. Safe: it only touches paths that are still symlinks.
cmd_restore() {
  local manifest="${1:-}"
  if [ -z "$manifest" ]; then
    # shellcheck disable=SC2012  # manifest names are timestamp+pid (no odd chars); ls -t = newest by mtime
    manifest="$(ls -1t "$STATE_DIR"/manifest-*.tsv 2>/dev/null | head -1 || true)"
  fi
  if [ -z "$manifest" ] || [ ! -f "$manifest" ]; then
    log_error "No link manifest to restore (looked in $STATE_DIR)"
    return 1
  fi

  fmt_title_underline "Restoring from $(basename "$manifest")"
  local action target prev restored=0
  while IFS=$'\t' read -r action target prev; do
    [ -n "$action" ] || continue
    case "$action" in
      create)
        if [ -L "$target" ]; then
          rm "$target"
          log_info "removed  ~${target#"$HOME"}"
          restored=$((restored + 1))
        fi
        ;;
      replace)
        if [ -L "$target" ]; then
          rm "$target"
          ln -s "$prev" "$target"
          log_info "reverted ~${target#"$HOME"} → $prev"
          restored=$((restored + 1))
        else
          log_warning "skip ~${target#"$HOME"} — no longer a symlink"
        fi
        ;;
    esac
  done <"$manifest"

  echo
  log_success "Restored $restored change(s)"
  rm -f "$manifest"
}

main() {
  if [ $# -lt 1 ]; then
    usage
    exit 0
  fi

  cmd="$1"
  shift || true

  case "$cmd" in
    help)
      usage
      ;;
    clean)
      cmd_clean "$@"
      ;;
    backup)
      cmd_backup "$@"
      ;;
    link)
      cmd_link "link" "$@"
      ;;
    unlink)
      cmd_link "unlink" "$@"
      ;;
    restore)
      cmd_restore "$@"
      ;;
    *)
      if command -v "dot-$cmd" >/dev/null 2>&1; then
        "dot-$cmd" "$@"
      elif [[ -x "$script_dir/dot-$cmd" ]]; then
        "$script_dir/dot-$cmd" "$@"
      else
        log_error "Unknown command: $cmd"
        usage
        exit 1
      fi
      ;;
  esac
}

main "$@"
