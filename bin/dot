#!/usr/bin/env bash

set -Eeuo pipefail
trap cleanup SIGINT SIGTERM ERR EXIT

cleanup() {
  trap - SIGINT SIGTERM ERR EXIT
  if [[ -t 1 ]]; then tput cnorm 2>/dev/null || true; fi # enable cursor only when stdout is a tty
  # script cleanup here
}

command_name=$(basename "${BASH_SOURCE[0]}")
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)
DOTFILES="${DOTFILES:-$(cd "$script_dir/.." && pwd -P)}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dot"

if [[ -f "$DOTFILES/bin/lib/common.sh" ]]; then
  source "$DOTFILES/bin/lib/common.sh"
else
  echo "Error: Unable to source common.sh"
  exit 1
fi
# shellcheck disable=SC1091
source "$DOTFILES/bin/lib/links.sh"
# Drift detection (shared with dot-reconcile) — cmd_clean uses its dangling scan.
# shellcheck disable=SC1091
source "$DOTFILES/bin/lib/reconcile.sh"

find_commands() {
  IFS=: read -ra path_dirs <<<"$PATH"
  # Include script_dir so external commands are discoverable before bin/ is in PATH
  path_dirs+=("$script_dir")
  for dir in "${path_dirs[@]}"; do
    # skip if the directory doesn't exist or isn't readable
    [[ ! -d "$dir" ]] && continue
    for cmd in "$dir"/dot-*; do
      [[ -f "$cmd" && -x "$cmd" ]] || continue
      basename "$cmd" | sed 's/^dot-//'
    done
  done | sort -u
}

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_cmd "$command_name") $(fmt_value "<command> [subcommand] [options]")

Dotfiles management script.

$(fmt_key "Available Commands:")
    help                          Show this help message
    clean                         Clean up broken symlinks
        -n, --dry-run             Show what would be removed without actually removing
        -v, --verbose             Show detailed output
    backup                        Backup dotfiles
        -d, --directory <dir>   Backup directory (default: ~/dotfiles-backup)
    link                          Link dotfiles packages to their respective locations
        all                       Link all
        <pkg>                     Link a specific package
        -f, --force               Replace existing symlinks (refuses to overwrite real files)
        -b, --backup              On a real file: move it to <target>.backup.<ts>, then link (undo: dot restore)
        --adopt                   On a real file: import it INTO the repo, then link (opt-in; changes git state)
        -n, --dry-run             Preview the plan (CREATE/SKIP/REPLACE/CONFLICT); non-zero on conflict
        --status                  Show link status without making changes
        -v, --verbose             Show detailed output
    unlink                        Unlink dotfiles packages (never removes a symlink that isn't ours;
                                  a real file or a symlink pointing elsewhere is left alone with a warning)
        all                       Unlink all
        <pkg>                     Unlink a specific package
        -v, --verbose             Show detailed output
    restore                       Undo the last 'dot link' or 'dot unlink' run (removes/repoints
                                  created symlinks, or recreates unlinked ones)
        [manifest]                Restore a specific manifest instead of the newest
EOF

  echo -e "\nExternal commands:"

  find_commands | while read -r cmd; do
    # Get the description from the script if available
    description=$(grep "^# Description:" "$(which "dot-$cmd")" 2>/dev/null | cut -d: -f2- | sed 's/^[[:space:]]*//' || echo "No description available")
    printf "    $(fmt_cmd "%-12s") %s\n" "$cmd" "$description"
  done
}

cmd_clean() {
  local verbose=false
  local dry_run=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v | --verbose)
        verbose=true
        shift
        ;;
      -n | --dry-run)
        dry_run=true
        shift
        ;;
      *)
        log_error "Unknown argument: $1"
        return 1
        ;;
    esac
  done

  fmt_title_underline "Cleaning up broken symlinks"

  local broken_count=0
  # Paths the managed scan already handled, so the dangling scan below never
  # reports the same link twice in a --dry-run (newline-framed for exact match).
  local handled=$'\n'

  # Broken managed links (config packages + home files): the target is still a
  # symlink but its repo source no longer resolves. Foreign links (not pointing
  # into $DOTFILES) are never ours to remove.
  local source target label
  while IFS=$'\t' read -r source target label; do
    if [ -L "$target" ] && [ ! -e "$target" ]; then
      broken_count=$((broken_count + 1))
      handled+="$target"$'\n'
      if [ "$dry_run" = true ]; then
        log_warning "[DRY RUN] Would remove broken symlink: ~${target#"$HOME"}"
      else
        [ "$verbose" = true ] && log_info "Removing broken symlink: ~${target#"$HOME"}"
        rm "$target"
      fi
    fi
  done < <(managed_targets)

  # Dangling links into $DOTFILES whose source is gone entirely: removed config
  # packages, plus home links whose repo file was DELETED — derived from git
  # history (shared reconcile scan), since no current repo file names them.
  local stale
  while IFS= read -r stale; do
    [ -n "$stale" ] || continue
    [[ "$handled" == *$'\n'"$stale"$'\n'* ]] && continue
    broken_count=$((broken_count + 1))
    if [ "$dry_run" = true ]; then
      log_warning "[DRY RUN] Would remove broken symlink: ~${stale#"$HOME"}"
    else
      [ "$verbose" = true ] && log_info "Removing broken symlink: ~${stale#"$HOME"}"
      rm "$stale"
    fi
  done < <(reconcile_symlinks_dangling)

  echo
  if [ "$broken_count" -eq 0 ]; then
    log_success "No broken symlinks found"
  else
    if [ "$dry_run" = true ]; then
      log_info "Found $broken_count broken symlink(s). Run without --dry-run to remove them."
    else
      log_success "Removed $broken_count broken symlink(s)"
    fi
  fi
}

cmd_backup() {
  local backup_dir="$HOME/dotfiles-backup"
  local verbose=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d | --directory)
        if [[ -n "${2:-}" ]]; then
          backup_dir="$2"
          shift 2
        else
          log_error "Missing backup directory"
          return 1
        fi
        ;;
      -v | --verbose)
        verbose=true
        shift
        ;;
      *)
        log_error "Unknown argument: $1"
        return 1
        ;;
    esac
  done

  # Expand ~ in backup_dir
  backup_dir="${backup_dir/#\~/$HOME}"

  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local backup_path="${backup_dir}/dotfiles_backup_${timestamp}"

  log_info "Creating backup in: $backup_path"

  # Derive backup list from managed targets (single source of truth),
  # as paths relative to $HOME for the tar -C "$HOME" call below.
  files_to_backup=()
  local source target label
  while IFS=$'\t' read -r source target label; do
    files_to_backup+=("${target#"$HOME"/}")
  done < <(managed_targets)

  tmpfile=$(mktemp)

  for file in "${files_to_backup[@]}"; do
    src_path="${HOME}/${file}"
    if [[ -L "$src_path" ]]; then
      [[ "$verbose" == true ]] && log_info "Skipping symlink: $file"
      continue
    elif [[ -e "$src_path" ]]; then
      echo "$file" >>"$tmpfile"
      [[ "$verbose" == true ]] && log_info "Found: $file"
    else
      log_warning "File not found: $src_path"
    fi
  done

  if [[ -s "$tmpfile" ]]; then
    mkdir -p "$backup_dir"
    if ! tar -czf "${backup_path}.tar.gz" -C "$HOME" -T "$tmpfile"; then
      log_error "Failed to create backup archive"
      rm -f "$tmpfile"
      return 1
    fi

    if [[ "$verbose" == true ]]; then
      log_info "Archive contents:"
      tar -tvf "${backup_path}.tar.gz" | while read -r line; do
        log_info "$line"
      done
    fi

    log_success "Backup created successfully"
  else
    log_warning "No files to backup"
  fi

  rm -f "$tmpfile"
}

link_status() {
  fmt_title_underline "Link Status"

  local ok=0 missing=0 wrong=0 real=0

  # Config packages
  local source target label state
  while IFS=$'\t' read -r source target label; do
    state=$(classify_link "$source" "$target")
    case "$state" in
      ok)
        printf "  %b%-22s%b %b%s%b\n" "$GREEN" "[OK]" "$RESET" "$DIM" "$label" "$RESET"
        ok=$((ok + 1))
        ;;
      wrong)
        printf "  %b%-22s%b %s → %s\n" "$YELLOW" "[WRONG]" "$RESET" "$label" "$(readlink "$target")"
        wrong=$((wrong + 1))
        ;;
      real)
        printf "  %b%-22s%b %s (real file/dir)\n" "$RED" "[REAL]" "$RESET" "$label"
        real=$((real + 1))
        ;;
      missing)
        printf "  %b%-22s%b %s\n" "$RED" "[MISSING]" "$RESET" "$label"
        missing=$((missing + 1))
        ;;
    esac
  done < <(managed_targets config)

  # Home files
  while IFS=$'\t' read -r source target label; do
    state=$(classify_link "$source" "$target")
    case "$state" in
      ok)
        printf "  %b%-22s%b %b%s%b\n" "$GREEN" "[OK]" "$RESET" "$DIM" "$label" "$RESET"
        ok=$((ok + 1))
        ;;
      wrong)
        printf "  %b%-22s%b %s → %s\n" "$YELLOW" "[WRONG]" "$RESET" "$label" "$(readlink "$target")"
        wrong=$((wrong + 1))
        ;;
      real)
        printf "  %b%-22s%b %s (real file)\n" "$RED" "[REAL]" "$RESET" "$label"
        real=$((real + 1))
        ;;
      missing)
        printf "  %b%-22s%b %s\n" "$RED" "[MISSING]" "$RESET" "$label"
        missing=$((missing + 1))
        ;;
    esac
  done < <(managed_targets home)

  echo
  printf "  %b%d ok%b  %b%d missing%b  %b%d wrong%b  %b%d real%b\n" \
    "$GREEN" "$ok" "$RESET" "$RED" "$missing" "$RESET" "$YELLOW" "$wrong" "$RESET" "$RED" "$real" "$RESET"
  # Non-zero when the linked state is broken/partial, so CI and `dot doctor` can gate on it.
  [ $((missing + wrong + real)) -eq 0 ]
}

# classify_link and managed_targets live in bin/lib/links.sh (shared with
# dot-reconcile's symlink drift detection).

# link_plan — preview what `dot link all` would do, classifying each managed
# target via classify_link. Never mutates the filesystem. Two-phase gate: it
# scans everything, then returns non-zero if any CONFLICT (a real file/dir in the
# way) so a caller/CI can refuse before a real run.
link_plan() {
  local verbose="${1:-false}"
  fmt_title_underline "Link plan (dry run)"

  local source target label state ccolor
  local creates=0 skips=0 replaces=0 conflicts=0
  while IFS=$'\t' read -r source target label; do
    state=$(classify_link "$source" "$target")
    # shellcheck disable=SC2088  # tilde is a display label, not expansion
    case "$state" in
      missing)
        printf "  %b%-9s%b %s\n" "$GREEN" "CREATE" "$RESET" "$label"
        creates=$((creates + 1))
        ;;
      ok)
        printf "  %b%-9s%b %b%s%b\n" "$DIM" "SKIP" "$RESET" "$DIM" "$label" "$RESET"
        skips=$((skips + 1))
        ;;
      wrong)
        printf "  %b%-9s%b %s → %s\n" "$YELLOW" "REPLACE" "$RESET" "$label" "$(readlink "$target")"
        replaces=$((replaces + 1))
        ;;
      real)
        printf "  %b%-9s%b %s (real file/dir in the way)\n" "$RED" "CONFLICT" "$RESET" "$label"
        conflicts=$((conflicts + 1))
        # With -v, show the content delta (live vs repo) for regular files.
        if [ "$verbose" = true ] && [ -f "$source" ] && [ -f "$target" ]; then
          diff -u "$target" "$source" | sed 's/^/      /' || true
        fi
        ;;
    esac
  done < <(managed_targets)

  ccolor="$DIM"
  [ "$conflicts" -gt 0 ] && ccolor="$RED"
  echo
  printf "  %b%d create%b · %b%d skip%b · %b%d replace%b · %b%d conflict%b\n" \
    "$GREEN" "$creates" "$RESET" "$DIM" "$skips" "$RESET" \
    "$YELLOW" "$replaces" "$RESET" "$ccolor" "$conflicts" "$RESET"
  [ "$conflicts" -gt 0 ] && log_warning "Conflicts block a real run — back up or remove the real files first (dot backup)"
  [ "$conflicts" -eq 0 ]
}

# link_apply <source> <target> <label> <verbose> <force> — perform the action the
# plan previews, deciding via the SAME classify_link the plan uses so `dot link`
# and `dot link -n` can never disagree. Creates parent dirs as needed.
# Append an undo record to the current run's manifest (if one is active). Row:
# "<action>\t<target>\t<prev>" — prev is what restore sets <target> back to
# (empty = remove). No-op when DOT_MANIFEST is unset (e.g. single-package link).
manifest_record() {
  [ -n "${DOT_MANIFEST:-}" ] || return 0
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >>"$DOT_MANIFEST"
}

link_apply() {
  local source="$1" target="$2" label="$3" verbose="$4" force="$5"
  local backup="${6:-false}" adopt="${7:-false}"
  local target_dir
  target_dir="$(dirname "$target")"
  if [ ! -d "$target_dir" ]; then
    [ "$verbose" = true ] && log_info "Creating directory: $target_dir"
    mkdir -p "$target_dir"
  fi
  # shellcheck disable=SC2088  # tilde in labels is display, not expansion
  case "$(classify_link "$source" "$target")" in
    missing)
      [ "$verbose" = true ] && log_info "CREATE  $label"
      ln -s "$source" "$target"
      manifest_record "create" "$target" ""
      ;;
    ok)
      # Use `if`, not `&&`: a bare failing test here would make link_apply return
      # non-zero and trip `set -e` in the caller's loop on an all-SKIP re-run.
      if [ "$verbose" = true ]; then
        log_info "SKIP    $label (already linked)"
      fi
      ;;
    wrong)
      if [ "$force" = true ]; then
        [ "$verbose" = true ] && log_info "REPLACE $label → $source"
        local prev
        prev="$(readlink "$target")"
        rm "$target"
        ln -s "$source" "$target"
        manifest_record "replace" "$target" "$prev"
      else
        log_warning "$label points elsewhere ($(readlink "$target")) — rerun with -f to replace"
      fi
      ;;
    real)
      if [ "$adopt" = true ]; then
        # Import the live file INTO the repo, then link. This overwrites the repo's
        # version (git-recoverable), so it's opt-in and not manifest-recorded.
        [ "$verbose" = true ] && log_info "ADOPT   $label → repo (review with: git -C \"\$DOTFILES\" diff)"
        rm -rf "$source"
        mv "$target" "$source"
        ln -s "$source" "$target"
      elif [ "$backup" = true ]; then
        # Sideline the real file to a timestamped backup, then link. Recorded so
        # `dot restore` puts the original back.
        local bak
        bak="$target.backup.$(date +%Y%m%d_%H%M%S)"
        [ "$verbose" = true ] && log_info "BACKUP  $label → $(basename "$bak")"
        mv "$target" "$bak"
        ln -s "$source" "$target"
        manifest_record "backup" "$target" "$bak"
      else
        log_warning "$label is a real file/dir — skipping (use -b to back it up and link, or --adopt to import it into the repo)"
      fi
      ;;
  esac
}

# unlink_apply <source> <target> <label> <verbose> — the unlink-direction
# sibling of link_apply, sharing classify_link so the two directions can never
# disagree about a target's state. Deliberately narrower than link_apply: unlink
# has no force/backup/adopt equivalent. `wrong` (points anywhere but the
# expected source) is always refused, whether truly foreign or a stale pointer
# left by a renamed package — unlink never guesses, only removes what it's sure
# is ours. Append an undo record to the active manifest, same convention as
# link_apply (no-op when DOT_MANIFEST is unset).
unlink_apply() {
  local source="$1" target="$2" label="$3" verbose="$4"
  # shellcheck disable=SC2088  # tilde in labels is display, not expansion
  case "$(classify_link "$source" "$target")" in
    missing) ;;
    ok)
      [ "$verbose" = true ] && log_info "UNLINK  $label"
      rm "$target"
      manifest_record "delete" "$target" "$source"
      ;;
    wrong)
      log_warning "$label points elsewhere ($(readlink "$target")) — not ours, leaving it"
      ;;
    real)
      log_warning "$label is a real file/dir, not a symlink — leaving it"
      ;;
  esac
}

cmd_link() {
  local operation="$1"
  local pkg="$2"
  shift 2 || true

  # Handle 'dot link --status' (no pkg required)
  if [ "$operation" = "link" ] && [ "$pkg" = "--status" ]; then
    link_status
    return
  fi

  local verbose=false
  local force=false
  local dry_run=false
  local backup=false
  local adopt=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v | --verbose)
        verbose=true
        shift
        ;;
      -f | --force)
        force=true
        shift
        ;;
      -b | --backup)
        backup=true
        shift
        ;;
      --adopt)
        adopt=true
        shift
        ;;
      --status)
        link_status
        return
        ;;
      -n | --dry-run)
        dry_run=true
        shift
        ;;
      *)
        log_error "Unknown argument: $1"
        exit 1
        ;;
    esac
  done

  # Preview the plan and stop — never mutates. Non-zero exit if any conflict.
  if [ "$dry_run" = true ]; then
    if [ "$operation" != "link" ]; then
      log_error "--dry-run is only supported for 'dot link'"
      exit 1
    fi
    link_plan "$verbose"
    return $?
  fi

  local title_text
  if [ "$pkg" = "all" ]; then
    title_text="${operation}ing all packages"
  else
    title_text="${operation}ing package: $pkg"
  fi

  fmt_title_underline "$title_text"

  if [ "$pkg" = "all" ]; then
    if [ "$operation" = "link" ]; then
      # Record every mutation to a per-run manifest so `dot restore` can undo it.
      mkdir -p "$STATE_DIR"
      DOT_MANIFEST="$STATE_DIR/manifest-$(date +%Y%m%d_%H%M%S)-$$.tsv"
      # Link every managed target via the SAME walk + classifier the plan uses,
      # so `dot link all` and `dot link all -n` can never disagree.
      local source target label
      while IFS=$'\t' read -r source target label; do
        link_apply "$source" "$target" "$label" "$verbose" "$force" "$backup" "$adopt"
      done < <(managed_targets)
      # Drop an empty manifest (a no-op re-run changed nothing to undo).
      if [ -s "$DOT_MANIFEST" ]; then
        log_info "Recorded $(wc -l <"$DOT_MANIFEST" | tr -d ' ') change(s) — undo with: dot restore"
      else
        rm -f "$DOT_MANIFEST"
      fi
      unset DOT_MANIFEST
    else # unlink
      # Record every mutation to a per-run manifest so `dot restore` can undo
      # it — same convention as `link all`, via the SAME walk + classifier so
      # the two directions can never disagree about what's managed.
      mkdir -p "$STATE_DIR"
      DOT_MANIFEST="$STATE_DIR/manifest-$(date +%Y%m%d_%H%M%S)-$$.tsv"
      local source target label
      while IFS=$'\t' read -r source target label; do
        unlink_apply "$source" "$target" "$label" "$verbose"
      done < <(managed_targets)
      if [ -s "$DOT_MANIFEST" ]; then
        log_info "Recorded $(wc -l <"$DOT_MANIFEST" | tr -d ' ') change(s) — undo with: dot restore"
      else
        rm -f "$DOT_MANIFEST"
      fi
      unset DOT_MANIFEST
    fi
  else
    # Handle specific package
    local target="$CONFIG_HOME/$pkg"
    if [ -d "$DOTFILES/config/$pkg" ]; then
      # skip empty config packages (nothing to link)
      if [[ -z "$(ls -A "$DOTFILES/config/$pkg" 2>/dev/null)" ]]; then
        log_warning "Package $pkg is empty, skipping"
        return 0
      fi
      # Single-package gets the same manifest tracking as `all` — previously
      # silently un-undoable via `dot restore`.
      mkdir -p "$STATE_DIR"
      DOT_MANIFEST="$STATE_DIR/manifest-$(date +%Y%m%d_%H%M%S)-$$.tsv"
      # shellcheck disable=SC2088  # tilde in labels is display, not expansion
      if [ "$operation" = "link" ]; then
        link_apply "$DOTFILES/config/$pkg" "$target" "~/.config/$pkg" "$verbose" "$force" "$backup" "$adopt"
      else # unlink
        unlink_apply "$DOTFILES/config/$pkg" "$target" "~/.config/$pkg" "$verbose"
      fi
      if [ -s "$DOT_MANIFEST" ]; then
        log_info "Recorded $(wc -l <"$DOT_MANIFEST" | tr -d ' ') change(s) — undo with: dot restore"
      else
        rm -f "$DOT_MANIFEST"
      fi
      unset DOT_MANIFEST
    else
      log_error "Package $pkg not found in config directory"
      return 1
    fi
  fi

  echo -e
  log_success "Done"
}

# Undo a `dot link` run from its manifest (newest, or an explicit file). Reverses
# each recorded mutation: a created symlink is removed; a replaced one is repointed
# to its previous target. Safe: it only touches paths that are still symlinks.
cmd_restore() {
  local manifest="${1:-}"
  if [ -z "$manifest" ]; then
    # shellcheck disable=SC2012  # manifest names are timestamp+pid (no odd chars); ls -t = newest by mtime
    manifest="$(ls -1t "$STATE_DIR"/manifest-*.tsv 2>/dev/null | head -1 || true)"
  fi
  if [ -z "$manifest" ] || [ ! -f "$manifest" ]; then
    log_error "No link manifest to restore (looked in $STATE_DIR)"
    return 1
  fi

  fmt_title_underline "Restoring from $(basename "$manifest")"
  local action target prev restored=0
  while IFS=$'\t' read -r action target prev; do
    [ -n "$action" ] || continue
    case "$action" in
      create)
        if [ -L "$target" ]; then
          rm "$target"
          log_info "removed  ~${target#"$HOME"}"
          restored=$((restored + 1))
        fi
        ;;
      replace)
        if [ -L "$target" ]; then
          rm "$target"
          ln -s "$prev" "$target"
          log_info "reverted ~${target#"$HOME"} → $prev"
          restored=$((restored + 1))
        else
          log_warning "skip ~${target#"$HOME"} — no longer a symlink"
        fi
        ;;
      backup)
        # prev holds the sidelined backup path; put it back over our symlink.
        if [ -L "$target" ] && [ -e "$prev" ]; then
          rm "$target"
          mv "$prev" "$target"
          log_info "restored ~${target#"$HOME"} from backup"
          restored=$((restored + 1))
        else
          log_warning "skip ~${target#"$HOME"} — link or backup missing"
        fi
        ;;
      delete)
        # prev holds what unlink_apply removed; recreate it, unless something
        # now occupies the path (never clobber — same guard as replace/backup).
        if [ ! -e "$target" ]; then
          ln -s "$prev" "$target"
          log_info "recreated ~${target#"$HOME"} → $prev"
          restored=$((restored + 1))
        else
          log_warning "skip ~${target#"$HOME"} — something now exists there"
        fi
        ;;
    esac
  done <"$manifest"

  echo
  log_success "Restored $restored change(s)"
  rm -f "$manifest"
}

main() {
  if [ $# -lt 1 ]; then
    usage
    exit 0
  fi

  cmd="$1"
  shift || true

  case "$cmd" in
    help)
      usage
      ;;
    clean)
      cmd_clean "$@"
      ;;
    backup)
      cmd_backup "$@"
      ;;
    link)
      cmd_link "link" "$@"
      ;;
    unlink)
      cmd_link "unlink" "$@"
      ;;
    restore)
      cmd_restore "$@"
      ;;
    *)
      if command -v "dot-$cmd" >/dev/null 2>&1; then
        "dot-$cmd" "$@"
      elif [[ -x "$script_dir/dot-$cmd" ]]; then
        "$script_dir/dot-$cmd" "$@"
      else
        log_error "Unknown command: $cmd"
        usage
        exit 1
      fi
      ;;
  esac
}

main "$@"
