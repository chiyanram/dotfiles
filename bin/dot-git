#!/usr/bin/env bash
# Description: Setup Git configuration personalized for you.

set -Eeuo pipefail
DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"

# source helpers
source "$DOTFILES/bin/lib/common.sh"
command_name=$(basename "${BASH_SOURCE[0]}")

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_key "$command_name") $(fmt_value "[options] <command>")

Setup Git configuration personalized for you.

Options:
    -h, --help       Show this help message

Commands:
    setup            Setup the personal fallback identity (name, email, github user)
    add-identity     Build a git identity slot: SSH key + host alias + remote-bound, SSH-signed email
    use <slot>       Bind the current repo to an existing slot: rewrite origin to the slot
                     alias (key/email/signing follow) and, for GitHub slots, switch the gh account
    install-guard    Activate the Identity Guard globally by pointing core.hooksPath at the
                     committed pre-commit hook (written to ~/.gitconfig-local, never committed)

add-identity options:
    --name <slot>       Slot name, e.g. ee (required)
    --host <host>       Git host, e.g. github.com (required)
    --email <email>     Commit email bound to this slot (required)
    --github-user <u>   GitHub username for this slot (optional)
    --key <path>        Adopt an existing SSH private key instead of generating one
EOF
}

setup_git() {
  fmt_title_underline "Setting up Git configuration"

  if ! command -v git &>/dev/null; then
    log_error "Git is not installed. Exiting."
    exit 1
  fi

  local_config="$HOME/.gitconfig-local"

  defaultName=$(git config user.name 2>/dev/null || true)
  defaultEmail=$(git config user.email 2>/dev/null || true)
  defaultGithub=$(git config github.user 2>/dev/null || true)

  read -rp "Name [$defaultName] " name
  read -rp "Email [$defaultEmail] " email
  read -rp "Github username [$defaultGithub] " github

  git config -f "$local_config" user.name "${name:-$defaultName}"
  git config -f "$local_config" user.email "${email:-$defaultEmail}"
  git config -f "$local_config" github.user "${github:-$defaultGithub}"

  if [[ "$(uname)" == "Darwin" ]]; then
    git config -f "$local_config" credential.helper "osxkeychain"
  else
    read -rn 1 -p "Save user and password to an unencrypted file to avoid writing? [y/N] " save
    if [[ $save =~ ^([Yy])$ ]]; then
      git config -f "$local_config" credential.helper "store"
    else
      git config -f "$local_config" credential.helper "cache --timeout 3600"
    fi
  fi
}

# Rewrite ~/.ssh/config, dropping any existing block for the given Host alias so a
# re-run updates rather than duplicates. A block is the `Host <alias>` line plus its
# following indented/blank lines, up to the next top-level directive. BSD-awk safe.
ssh_config_drop_alias() {
  local ssh_config="$1" alias="$2"
  local tmp
  tmp="$(mktemp)"
  awk -v hostline="Host $alias" '
    $0 == hostline { skip = 1; next }
    skip && $0 ~ /^[ \t]/ { next }
    skip && $0 ~ /^[ \t]*$/ { next }
    { skip = 0; print }
  ' "$ssh_config" >"$tmp"
  mv "$tmp" "$ssh_config"
}

git_add_identity() {
  local name="" host="" email="" github_user="" key=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        name="${2:-}"
        shift 2
        ;;
      --host)
        host="${2:-}"
        shift 2
        ;;
      --email)
        email="${2:-}"
        shift 2
        ;;
      --github-user)
        github_user="${2:-}"
        shift 2
        ;;
      --key)
        key="${2:-}"
        shift 2
        ;;
      *)
        log_error "Unknown argument: $1"
        return 1
        ;;
    esac
  done

  if [[ -z "$name" || -z "$host" || -z "$email" ]]; then
    log_error "--name, --host, and --email are required"
    return 1
  fi

  if ! command -v git &>/dev/null; then
    log_error "Git is not installed."
    return 1
  fi

  fmt_title_underline "Adding git identity slot: $name"

  local alias="${host}-${name}"
  local keypath

  # SSH key: adopt an existing one via --key, otherwise generate a passphrase-protected
  # key (ssh-keygen prompts for the passphrase interactively on the real path).
  if [[ -n "$key" ]]; then
    key="${key/#\~/$HOME}" # expand a leading ~ to an absolute path
    if [[ ! -f "$key" ]]; then
      log_error "SSH key not found: $key"
      return 1
    fi
    keypath="$key"
  else
    keypath="$HOME/.ssh/id_ed25519_${name}"
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    if [[ -f "$keypath" ]]; then
      log_info "Reusing existing key at $keypath"
    else
      if ! command -v ssh-keygen &>/dev/null; then
        log_error "ssh-keygen is not installed."
        return 1
      fi
      ssh-keygen -t ed25519 -C "$email" -f "$keypath"
    fi
  fi

  # SSH host alias that selects this slot's key (idempotent).
  local ssh_config="$HOME/.ssh/config"
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  touch "$ssh_config"
  ssh_config_drop_alias "$ssh_config" "$alias"
  {
    printf 'Host %s\n' "$alias"
    printf '    HostName %s\n' "$host"
    printf '    IdentityFile %s\n' "$keypath"
    printf '    IdentitiesOnly yes\n'
    printf '    AddKeysToAgent yes\n'
    printf '    UseKeychain yes\n'
  } >>"$ssh_config"
  chmod 600 "$ssh_config"

  local pubkey="${keypath}.pub"

  # Per-slot git config fragment: commit email + SSH-format signing with this slot's
  # key (git config is idempotent). Signing key == auth key, so a verified commit can
  # never show the wrong identity.
  local fragment="$HOME/.gitconfig-$name"
  git config -f "$fragment" user.email "$email"
  if [[ -n "$github_user" ]]; then
    git config -f "$fragment" github.user "$github_user"
  fi
  git config -f "$fragment" gpg.format ssh
  git config -f "$fragment" user.signingkey "$pubkey"
  git config -f "$fragment" commit.gpgsign true
  git config -f "$fragment" tag.gpgsign true

  # Allowed-signers entry so signatures verify locally (git log --show-signature,
  # git verify-commit). One idempotent `<email> <keytype> <keydata>` line per slot;
  # gpg.ssh.allowedSignersFile points here as a neutral setting in config/git/config.
  local allowed_signers="$HOME/.config/git/allowed_signers"
  if [[ -f "$pubkey" ]]; then
    mkdir -p "$(dirname "$allowed_signers")"
    touch "$allowed_signers"
    # Take only keytype+keydata (drop the trailing comment) so the principal binds to
    # exactly one key regardless of the .pub file's comment.
    local keytype keydata signer_line
    read -r keytype keydata _ <"$pubkey"
    signer_line="$email $keytype $keydata"
    if ! grep -qF "$signer_line" "$allowed_signers"; then
      printf '%s\n' "$signer_line" >>"$allowed_signers"
    fi
  fi

  # hasconfig include that binds this email to the alias (idempotent append).
  local identities="$HOME/.gitconfig-identities"
  touch "$identities"
  # `*/**` (not the bare `:**` the design sketched) is required: git's hasconfig glob
  # only lets `**` cross a `/` when slash-delimited, so `:**` never matches an scp URL's
  # owner/repo path. `*/**` matches owner/repo, owner/team/repo, and .git-less forms.
  local includeif="[includeIf \"hasconfig:remote.*.url:git@${alias}:*/**\"]"
  if ! grep -qF "$includeif" "$identities"; then
    {
      printf '%s\n' "$includeif"
      printf '\tpath = ~/.gitconfig-%s\n' "$name"
    } >>"$identities"
  fi

  log_success "Identity slot '$name' ready — remote-bound to $alias, commits SSH-signed"
  log_info "email: $email — commits in repos whose remote uses $alias are authored and signed as this slot"

  if [[ -f "$pubkey" ]]; then
    log_info "Register this public key on the $host account for $alias as BOTH an"
    log_info "Authentication key AND a Signing key (or $host shows signatures as \"Unverified\"):"
    cat "$pubkey"
  else
    log_warning "No public key found at $pubkey — register the matching public key on the $host account as both an Authentication and a Signing key."
  fi
}

# Resolve a slot name to its SSH alias (<host>-<name>) via the slot's hasconfig
# include in ~/.gitconfig-identities. The include's `path = ~/.gitconfig-<name>`
# uniquely names the slot, and the preceding includeIf embeds `git@<alias>:...`,
# so pairing the two yields the alias. Prints the alias; returns 1 if not found.
slot_alias() {
  local name="$1" identities="$HOME/.gitconfig-identities"
  [[ -f "$identities" ]] || return 1
  awk -v slot="$name" '
    /^[ \t]*\[includeIf / {
      if (match($0, /git@[^:]+:/)) {
        # Strip the leading "git@" (4 chars) and the trailing ":" (1 char).
        alias = substr($0, RSTART + 4, RLENGTH - 5)
      }
      next
    }
    /path[ \t]*=/ {
      p = $0
      sub(/.*path[ \t]*=[ \t]*/, "", p)
      if (p == "~/.gitconfig-" slot) {
        print alias
        found = 1
        exit
      }
    }
    END { if (!found) exit 1 }
  ' "$identities"
}

# Extract owner/repo (keeping any trailing .git) from an origin URL, handling
# HTTPS, ssh://, and scp-style (incl. already-aliased) forms. Prints owner/repo;
# returns 1 on an unrecognized URL.
origin_owner_repo() {
  local url="$1" rest
  case "$url" in
    https://* | http://*)
      rest="${url#*://}" # host/owner/repo.git
      printf '%s\n' "${rest#*/}"
      ;;
    ssh://*)
      rest="${url#ssh://}" # [user@]host[:port]/owner/repo.git
      rest="${rest#*@}"    # drop user@ if present
      printf '%s\n' "${rest#*/}"
      ;;
    *:*)
      # scp-style: [user@]host:owner/repo.git (host alias never contains a colon).
      printf '%s\n' "${url#*:}"
      ;;
    *)
      return 1
      ;;
  esac
}

git_use() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    log_error "Usage: $command_name use <slot>"
    return 1
  fi

  if ! command -v git &>/dev/null; then
    log_error "Git is not installed."
    return 1
  fi

  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    log_error "Not inside a git repository — run 'dot git use' from a repo."
    return 1
  fi

  local alias
  if ! alias="$(slot_alias "$name")" || [[ -z "$alias" ]]; then
    log_error "No identity slot '$name' — create it first with: $command_name add-identity --name $name --host <host> --email <email>"
    return 1
  fi
  local host="${alias%-"$name"}" # alias is <host>-<name>

  local url
  if ! url="$(git remote get-url origin 2>/dev/null)" || [[ -z "$url" ]]; then
    log_error "No 'origin' remote in this repository — add one, then re-run: $command_name use $name"
    return 1
  fi

  local ownerrepo
  if ! ownerrepo="$(origin_owner_repo "$url")" || [[ -z "$ownerrepo" ]]; then
    log_error "Could not parse owner/repo from origin URL: $url"
    return 1
  fi

  local newurl="git@${alias}:${ownerrepo}"
  git remote set-url origin "$newurl"

  # Verify the bind: the hasconfig include should now select the slot fragment.
  local slot_email resolved
  slot_email="$(git config -f "$HOME/.gitconfig-$name" user.email 2>/dev/null || true)"
  resolved="$(git config user.email 2>/dev/null || true)"
  if [[ -n "$slot_email" && "$resolved" == "$slot_email" ]]; then
    log_success "Bound this repo to slot '$name' — origin is $newurl, commits authored/signed as $resolved"
  else
    log_warning "origin rewritten to $newurl, but user.email resolved to '${resolved:-<unset>}' (expected '${slot_email:-<unknown>}')"
  fi

  # gh account sync: GitHub-only, and only when a gh CLI and a slot github user
  # are both present. Never fail the whole command if the switch fails — the
  # git-side bind already succeeded.
  case "$host" in
    github.com | github.*)
      local slot_ghuser
      slot_ghuser="$(git config -f "$HOME/.gitconfig-$name" github.user 2>/dev/null || true)"
      if ! command -v gh &>/dev/null; then
        log_info "gh not found — skipping GitHub account switch (git identity is already bound)."
      elif [[ -z "$slot_ghuser" ]]; then
        log_info "Slot '$name' has no github.user — skipping gh account switch."
      elif gh auth switch --hostname "$host" --user "$slot_ghuser" >/dev/null 2>&1; then
        log_success "Switched active gh account to '$slot_ghuser' on $host."
      else
        log_warning "Could not switch gh account to '$slot_ghuser' on $host — run 'gh auth switch --user $slot_ghuser' manually."
      fi
      ;;
  esac
}

# Activate the Identity Guard: point core.hooksPath at the committed hook directory.
# The path is machine-specific and absolute, so it goes in ~/.gitconfig-local — never
# in the committed config/git/config (which is shared across machines).
git_install_guard() {
  if ! command -v git &>/dev/null; then
    log_error "Git is not installed."
    return 1
  fi

  local hook_dir="$DOTFILES/config/git/hooks"
  if [[ ! -d "$hook_dir" ]]; then
    log_error "Hook directory not found: $hook_dir"
    return 1
  fi
  hook_dir="$(cd "$hook_dir" && pwd -P)"

  if [[ ! -x "$hook_dir/pre-commit" ]]; then
    log_error "Guard hook missing or not executable: $hook_dir/pre-commit"
    return 1
  fi

  git config -f "$HOME/.gitconfig-local" core.hooksPath "$hook_dir"
  log_success "Identity Guard installed — core.hooksPath -> $hook_dir"
  log_info "Written to ~/.gitconfig-local (machine-local, not committed)."
}

main() {
  if [ $# -lt 1 ]; then
    usage
    exit 0
  fi

  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    setup)
      setup_git
      ;;
    add-identity)
      shift
      git_add_identity "$@"
      ;;
    use)
      shift
      git_use "$@"
      ;;
    install-guard)
      shift
      git_install_guard "$@"
      ;;
    *)
      log_error "Unknown legacy command: $1"
      echo -e
      usage
      exit 1
      ;;
  esac
}

main "$@"
