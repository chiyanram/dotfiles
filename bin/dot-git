#!/usr/bin/env bash
# Description: Setup Git configuration personalized for you.

set -Eeuo pipefail
DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"

# source helpers
source "$DOTFILES/bin/lib/common.sh"
command_name=$(basename "${BASH_SOURCE[0]}")

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_key "$command_name") $(fmt_value "[options] <command>")

Setup Git configuration personalized for you.

Options:
    -h, --help       Show this help message

Commands:
    setup            Setup the personal fallback identity (name, email, github user)
    add-identity     Build a git identity slot: SSH key + host alias + remote-bound email

add-identity options:
    --name <slot>       Slot name, e.g. ee (required)
    --host <host>       Git host, e.g. github.com (required)
    --email <email>     Commit email bound to this slot (required)
    --github-user <u>   GitHub username for this slot (optional)
    --key <path>        Adopt an existing SSH private key instead of generating one
EOF
}

setup_git() {
  fmt_title_underline "Setting up Git configuration"

  if ! command -v git &>/dev/null; then
    log_error "Git is not installed. Exiting."
    exit 1
  fi

  local_config="$HOME/.gitconfig-local"

  defaultName=$(git config user.name 2>/dev/null || true)
  defaultEmail=$(git config user.email 2>/dev/null || true)
  defaultGithub=$(git config github.user 2>/dev/null || true)

  read -rp "Name [$defaultName] " name
  read -rp "Email [$defaultEmail] " email
  read -rp "Github username [$defaultGithub] " github

  git config -f "$local_config" user.name "${name:-$defaultName}"
  git config -f "$local_config" user.email "${email:-$defaultEmail}"
  git config -f "$local_config" github.user "${github:-$defaultGithub}"

  if [[ "$(uname)" == "Darwin" ]]; then
    git config -f "$local_config" credential.helper "osxkeychain"
  else
    read -rn 1 -p "Save user and password to an unencrypted file to avoid writing? [y/N] " save
    if [[ $save =~ ^([Yy])$ ]]; then
      git config -f "$local_config" credential.helper "store"
    else
      git config -f "$local_config" credential.helper "cache --timeout 3600"
    fi
  fi
}

# Rewrite ~/.ssh/config, dropping any existing block for the given Host alias so a
# re-run updates rather than duplicates. A block is the `Host <alias>` line plus its
# following indented/blank lines, up to the next top-level directive. BSD-awk safe.
ssh_config_drop_alias() {
  local ssh_config="$1" alias="$2"
  local tmp
  tmp="$(mktemp)"
  awk -v hostline="Host $alias" '
    $0 == hostline { skip = 1; next }
    skip && $0 ~ /^[ \t]/ { next }
    skip && $0 ~ /^[ \t]*$/ { next }
    { skip = 0; print }
  ' "$ssh_config" >"$tmp"
  mv "$tmp" "$ssh_config"
}

git_add_identity() {
  local name="" host="" email="" github_user="" key=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        name="${2:-}"
        shift 2
        ;;
      --host)
        host="${2:-}"
        shift 2
        ;;
      --email)
        email="${2:-}"
        shift 2
        ;;
      --github-user)
        github_user="${2:-}"
        shift 2
        ;;
      --key)
        key="${2:-}"
        shift 2
        ;;
      *)
        log_error "Unknown argument: $1"
        return 1
        ;;
    esac
  done

  if [[ -z "$name" || -z "$host" || -z "$email" ]]; then
    log_error "--name, --host, and --email are required"
    return 1
  fi

  if ! command -v git &>/dev/null; then
    log_error "Git is not installed."
    return 1
  fi

  fmt_title_underline "Adding git identity slot: $name"

  local alias="${host}-${name}"
  local keypath

  # SSH key: adopt an existing one via --key, otherwise generate a passphrase-protected
  # key (ssh-keygen prompts for the passphrase interactively on the real path).
  if [[ -n "$key" ]]; then
    key="${key/#\~/$HOME}" # expand a leading ~ to an absolute path
    if [[ ! -f "$key" ]]; then
      log_error "SSH key not found: $key"
      return 1
    fi
    keypath="$key"
  else
    keypath="$HOME/.ssh/id_ed25519_${name}"
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    if [[ -f "$keypath" ]]; then
      log_info "Reusing existing key at $keypath"
    else
      if ! command -v ssh-keygen &>/dev/null; then
        log_error "ssh-keygen is not installed."
        return 1
      fi
      ssh-keygen -t ed25519 -C "$email" -f "$keypath"
    fi
  fi

  # SSH host alias that selects this slot's key (idempotent).
  local ssh_config="$HOME/.ssh/config"
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  touch "$ssh_config"
  ssh_config_drop_alias "$ssh_config" "$alias"
  {
    printf 'Host %s\n' "$alias"
    printf '    HostName %s\n' "$host"
    printf '    IdentityFile %s\n' "$keypath"
    printf '    IdentitiesOnly yes\n'
    printf '    AddKeysToAgent yes\n'
    printf '    UseKeychain yes\n'
  } >>"$ssh_config"
  chmod 600 "$ssh_config"

  # Per-slot git config fragment carrying the commit email (git config is idempotent).
  local fragment="$HOME/.gitconfig-$name"
  git config -f "$fragment" user.email "$email"
  if [[ -n "$github_user" ]]; then
    git config -f "$fragment" github.user "$github_user"
  fi

  # hasconfig include that binds this email to the alias (idempotent append).
  local identities="$HOME/.gitconfig-identities"
  touch "$identities"
  # `*/**` (not the bare `:**` the design sketched) is required: git's hasconfig glob
  # only lets `**` cross a `/` when slash-delimited, so `:**` never matches an scp URL's
  # owner/repo path. `*/**` matches owner/repo, owner/team/repo, and .git-less forms.
  local includeif="[includeIf \"hasconfig:remote.*.url:git@${alias}:*/**\"]"
  if ! grep -qF "$includeif" "$identities"; then
    {
      printf '%s\n' "$includeif"
      printf '\tpath = ~/.gitconfig-%s\n' "$name"
    } >>"$identities"
  fi

  log_success "Identity slot '$name' ready — remote-bound to $alias"
  log_info "email: $email — commits in repos whose remote uses $alias are authored as this slot"

  local pubkey="${keypath}.pub"
  if [[ -f "$pubkey" ]]; then
    log_info "Register this public key on the $host account for $alias:"
    cat "$pubkey"
  else
    log_warning "No public key found at $pubkey — register the matching public key on the $host account."
  fi
}

main() {
  if [ $# -lt 1 ]; then
    usage
    exit 0
  fi

  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    setup)
      setup_git
      ;;
    add-identity)
      shift
      git_add_identity "$@"
      ;;
    *)
      log_error "Unknown legacy command: $1"
      echo -e
      usage
      exit 1
      ;;
  esac
}

main "$@"
