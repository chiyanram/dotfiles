#!/usr/bin/env bash
# Description: Setup Git configuration personalized for you.

set -Eeuo pipefail
DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"

# source helpers
source "$DOTFILES/bin/lib/common.sh"
# Identity-slot detection + shared repo discovery (used by `use` and `migrate`).
# shellcheck disable=SC1091
source "$DOTFILES/bin/lib/git-slots.sh"
command_name=$(basename "${BASH_SOURCE[0]}")

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_key "$command_name") $(fmt_value "[options] <command>")

Setup Git configuration personalized for you.

Options:
    -h, --help       Show this help message

Commands:
    setup            Setup the personal fallback identity (name, email, github user)
    add-identity     Build a git identity slot: SSH key + host alias + remote-bound, SSH-signed email
    use <slot>       Bind the current repo to an existing slot: rewrite origin to the slot
                     alias (key/email/signing follow) and, for GitHub slots, switch the gh account
    register-key     Register an SSH key on a host account (trusts the host key, then uploads
                     via gh/glab as auth+signing); account-scoped, not repo-scoped
    migrate          Interactively onboard existing repos under the audit roots onto slots:
                     per mis-set repo, offer a slot and rebind its origin on confirm (git-side
                     only — no gh switch; run 'use' later to align gh)
    remove-identity <slot>
                     Symmetric teardown of a slot: SSH alias, gitconfig fragment, hasconfig
                     include, allowed_signers entry, and (if managed) its key pair. An adopted
                     key (--key at add-identity time) is left on disk with a warning.
    install-guard    Activate the Identity Guard globally by pointing core.hooksPath at the
                     committed pre-commit hook (written to ~/.gitconfig-local, never committed)

add-identity options:
    --name <slot>       Slot name, e.g. ee (required)
    --host <host>       Git host, e.g. github.com (required)
    --email <email>     Commit email bound to this slot (required)
    --github-user <u>   GitHub username for this slot (optional)
    --key <path>        Adopt an existing SSH private key instead of generating one

register-key options:
    --host <host>       Host to register the key on, e.g. gitlab.com (required)
    --key <path>        Public (or private) key to register (default ~/.ssh/id_ed25519.pub)
    --name <slot>       Slot name for the title/alias (default: derived from the key filename)
    --title <title>     Override the composed title "<name> @ <machine> · <alias> [· auth|sign]"
EOF
}

setup_git() {
  fmt_title_underline "Setting up Git configuration"

  if ! command -v git &>/dev/null; then
    log_error "Git is not installed. Exiting."
    exit 1
  fi

  local_config="$HOME/.gitconfig-local"

  defaultName=$(git config user.name 2>/dev/null || true)
  defaultEmail=$(git config user.email 2>/dev/null || true)
  defaultGithub=$(git config github.user 2>/dev/null || true)

  read -rp "Name [$defaultName] " name
  read -rp "Email [$defaultEmail] " email
  read -rp "Github username [$defaultGithub] " github

  git config -f "$local_config" user.name "${name:-$defaultName}"
  git config -f "$local_config" user.email "${email:-$defaultEmail}"
  git config -f "$local_config" github.user "${github:-$defaultGithub}"

  if [[ "$(uname)" == "Darwin" ]]; then
    git config -f "$local_config" credential.helper "osxkeychain"
  else
    read -rn 1 -p "Save user and password to an unencrypted file to avoid writing? [y/N] " save
    if [[ $save =~ ^([Yy])$ ]]; then
      git config -f "$local_config" credential.helper "store"
    else
      git config -f "$local_config" credential.helper "cache --timeout 3600"
    fi
  fi
}

# Rewrite ~/.ssh/config, dropping any existing block for the given Host alias so a
# re-run updates rather than duplicates. A block is the `Host <alias>` line plus its
# following indented/blank lines, up to the next top-level directive. BSD-awk safe.
ssh_config_drop_alias() {
  local ssh_config="$1" alias="$2"
  local tmp
  tmp="$(mktemp)"
  awk -v hostline="Host $alias" '
    $0 == hostline { skip = 1; next }
    skip && $0 ~ /^[ \t]/ { next }
    skip && $0 ~ /^[ \t]*$/ { next }
    { skip = 0; print }
  ' "$ssh_config" >"$tmp"
  mv "$tmp" "$ssh_config"
}

# Drop a slot's `[includeIf ...] / path = ...` block from ~/.gitconfig-identities
# (the exact two-line shape `dot git add-identity` appends). Mirrors
# ssh_config_drop_alias but the block is fixed-length (2 lines), not indent-delimited.
identities_drop_alias() {
  local identities="$1" alias="$2"
  local tmp
  tmp="$(mktemp)"
  awk -v includeif="[includeIf \"hasconfig:remote.*.url:git@${alias}:*/**\"]" '
    $0 == includeif { skip = 1; next }
    skip { skip = 0; next }
    { print }
  ' "$identities" >"$tmp"
  mv "$tmp" "$identities"
}

# Resolve the allowed_signers path, auto-migrating a pre-existing file from the
# old ~/.config/git/allowed_signers location (inside the symlinked, tracked
# config/git/ dir — see #58) to the new XDG state path the first time either
# add-identity or remove-identity touches it. Ensures the parent dir exists
# either way, mirroring the mkdir-before-touch the callers used to do inline.
_allowed_signers_path() {
  local old_path="$HOME/.config/git/allowed_signers"
  local new_path="${XDG_STATE_HOME:-$HOME/.local/state}/dot/git/allowed_signers"
  mkdir -p "$(dirname "$new_path")"
  if [[ -f "$old_path" && ! -f "$new_path" ]]; then
    mv "$old_path" "$new_path"
  fi
  printf '%s\n' "$new_path"
}

# Pure: decide HOW to register a public key on a host, given whether the host's
# CLI is present and authenticated. Prints one decision token:
#   github   register via gh (auth + signing are separate keys -> two calls)
#   gitlab   register via glab (one call; its --usage-type defaults to both)
#   paste    no usable CLI (absent/unauthed) or an unrecognized host -> print & paste
# No side effects; the wrapper builds the actual argv from this token, so a title
# with spaces can never break an eval'd command line.
_register_key_plan() {
  local host="$1" cli_present="$2" cli_authed="$3"
  if [[ "$cli_present" != "true" || "$cli_authed" != "true" ]]; then
    printf 'paste\n'
    return 0
  fi
  case "$host" in
    github.*) printf 'github\n' ;;
    gitlab.*) printf 'gitlab\n' ;;
    *) printf 'paste\n' ;;
  esac
}

# Pure: compose an SSH-key title "<name> @ <machine> · <alias>[ · <usage>]".
# usage is optional — empty for glab's single auth+signing key, "auth"/"sign"
# for gh's two separate keys so they're distinguishable on the account.
_register_key_title() {
  local name="$1" machine="$2" alias="$3" usage="${4:-}"
  if [[ -n "$usage" ]]; then
    printf '%s @ %s · %s · %s\n' "$name" "$machine" "$alias" "$usage"
  else
    printf '%s @ %s · %s\n' "$name" "$machine" "$alias"
  fi
}

# Pure: the identity name for a default (no-slot) key, derived from its filename.
# id_ed25519_<name> -> <name>; anything else (e.g. a plain id_ed25519) -> personal.
_register_key_derive_name() {
  local base="${1##*/}" # basename
  base="${base%.pub}"   # strip a trailing .pub
  case "$base" in
    id_ed25519_?*) printf '%s\n' "${base#id_ed25519_}" ;;
    *) printf 'personal\n' ;;
  esac
}

# Run one `<cli> ssh-key add <key> --title <title> <extra...>`, treating an
# "already registered" response as benign so register-key is idempotent. Built as
# an argv array (never eval'd), so a title with spaces can't split the command.
_register_key_upload() {
  local cli="$1" key="$2" title="$3"
  shift 3
  local out
  if out="$("$cli" ssh-key add "$key" --title "$title" "$@" 2>&1)"; then
    log_success "$cli registered key ($*)"
    return 0
  fi
  if grep -qiE 'already|exist|has already been taken|fingerprint' <<<"$out"; then
    log_info "$cli: key already registered ($*) — skipping."
    return 0
  fi
  log_warning "$cli ssh-key add failed ($*): $out"
  return 0
}

# Print-and-paste fallback when no authenticated CLI exists for the host.
_register_key_paste() {
  local host="$1" key="$2"
  log_warning "No authenticated CLI for $host — register this public key manually,"
  log_warning "as BOTH an Authentication and a Signing key:"
  case "$host" in
    github.*) log_info "  https://github.com/settings/ssh/new" ;;
    gitlab.*) log_info "  https://gitlab.com/-/user_settings/ssh_keys" ;;
  esac
  cat "$key"
  if command -v pbcopy &>/dev/null; then
    pbcopy <"$key" && log_info "Public key copied to clipboard."
  fi
}

# Register a public key on a host's account via the host's CLI (gh/glab), trusting
# the host key first so the next ssh/clone works. Account-scoped: needs --host and
# a key, never a repo. Registers as auth+signing; falls back to print-and-paste
# when no CLI is authenticated.
git_register_key() {
  local host="" key="" title="" name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host)
        host="${2:-}"
        shift 2
        ;;
      --key)
        key="${2:-}"
        shift 2
        ;;
      --title)
        title="${2:-}"
        shift 2
        ;;
      --name)
        name="${2:-}"
        shift 2
        ;;
      *)
        log_error "Unknown argument: $1"
        return 1
        ;;
    esac
  done

  if [[ -z "$host" ]]; then
    log_error "--host is required (e.g. --host gitlab.com)"
    return 1
  fi
  key="${key:-$HOME/.ssh/id_ed25519.pub}"
  key="${key/#\~/$HOME}"
  key="${key%.pub}.pub" # normalize a private-key path to its .pub
  if [[ ! -f "$key" ]]; then
    log_error "SSH public key not found: $key"
    return 1
  fi
  # Compose the key title "<name> @ <machine> · <alias>[ · <usage>]". A slot
  # (--name from add-identity) uses its <host>-<name> alias; a default key derives
  # its name from the filename and uses the bare host. --title overrides all this.
  local machine name_slug alias
  machine="$(hostname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  [[ -n "$machine" ]] || machine="dotfiles"
  if [[ -n "$name" ]]; then
    name_slug="$name"
    alias="${host}-${name}"
  else
    name_slug="$(_register_key_derive_name "$key")"
    alias="$host"
  fi

  fmt_title_underline "Registering SSH key on $host"

  ensure_known_host "$host" ||
    log_warning "Could not trust $host host key (offline?) — the first push may prompt."

  # Which CLI, and is it authenticated?
  local cli="" cli_present=false cli_authed=false
  case "$host" in
    github.*) cli=gh ;;
    gitlab.*) cli=glab ;;
  esac
  if [[ -n "$cli" ]] && command -v "$cli" &>/dev/null; then
    cli_present=true
    if "$cli" auth status &>/dev/null; then
      cli_authed=true
    fi
  fi

  case "$(_register_key_plan "$host" "$cli_present" "$cli_authed")" in
    github)
      # gh treats auth and signing as separate keys -> two calls with distinct
      # `· auth` / `· sign` titles so they're tellable apart on the account.
      _register_key_upload gh "$key" "${title:-$(_register_key_title "$name_slug" "$machine" "$alias" auth)}" --type authentication
      _register_key_upload gh "$key" "${title:-$(_register_key_title "$name_slug" "$machine" "$alias" sign)}" --type signing
      ;;
    gitlab)
      # glab's --usage-type defaults to auth_and_signing -> one call, no usage suffix.
      _register_key_upload glab "$key" "${title:-$(_register_key_title "$name_slug" "$machine" "$alias" "")}" --usage-type auth_and_signing
      ;;
    paste)
      _register_key_paste "$host" "$key"
      ;;
  esac
}

git_add_identity() {
  local name="" host="" email="" github_user="" key=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        name="${2:-}"
        shift 2
        ;;
      --host)
        host="${2:-}"
        shift 2
        ;;
      --email)
        email="${2:-}"
        shift 2
        ;;
      --github-user)
        github_user="${2:-}"
        shift 2
        ;;
      --key)
        key="${2:-}"
        shift 2
        ;;
      *)
        log_error "Unknown argument: $1"
        return 1
        ;;
    esac
  done

  if [[ -z "$name" || -z "$host" || -z "$email" ]]; then
    log_error "--name, --host, and --email are required"
    return 1
  fi

  if ! command -v git &>/dev/null; then
    log_error "Git is not installed."
    return 1
  fi

  fmt_title_underline "Adding git identity slot: $name"

  local alias="${host}-${name}"
  local keypath

  # SSH key: adopt an existing one via --key, otherwise generate a passphrase-protected
  # key (ssh-keygen prompts for the passphrase interactively on the real path).
  if [[ -n "$key" ]]; then
    key="${key/#\~/$HOME}" # expand a leading ~ to an absolute path
    if [[ ! -f "$key" ]]; then
      log_error "SSH key not found: $key"
      return 1
    fi
    keypath="$key"
  else
    keypath="$HOME/.ssh/id_ed25519_${name}"
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    if [[ -f "$keypath" ]]; then
      log_info "Reusing existing key at $keypath"
    else
      if ! command -v ssh-keygen &>/dev/null; then
        log_error "ssh-keygen is not installed."
        return 1
      fi
      ssh-keygen -t ed25519 -C "$email" -f "$keypath"
    fi
  fi

  # SSH host alias that selects this slot's key (idempotent).
  local ssh_config="$HOME/.ssh/config"
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  touch "$ssh_config"
  ssh_config_drop_alias "$ssh_config" "$alias"
  {
    printf 'Host %s\n' "$alias"
    printf '    HostName %s\n' "$host"
    printf '    IdentityFile %s\n' "$keypath"
    printf '    IdentitiesOnly yes\n'
    printf '    AddKeysToAgent yes\n'
    printf '    UseKeychain yes\n'
  } >>"$ssh_config"
  chmod 600 "$ssh_config"

  local pubkey="${keypath}.pub"

  # Per-slot git config fragment: commit email + SSH-format signing with this slot's
  # key (git config is idempotent). Signing key == auth key, so a verified commit can
  # never show the wrong identity.
  local fragment="$HOME/.gitconfig-$name"
  git config -f "$fragment" user.email "$email"
  if [[ -n "$github_user" ]]; then
    git config -f "$fragment" github.user "$github_user"
  fi
  git config -f "$fragment" gpg.format ssh
  git config -f "$fragment" user.signingkey "$pubkey"
  git config -f "$fragment" commit.gpgsign true
  git config -f "$fragment" tag.gpgsign true

  # Allowed-signers entry so signatures verify locally (git log --show-signature,
  # git verify-commit). One idempotent `<email> <keytype> <keydata>` line per slot;
  # gpg.ssh.allowedSignersFile points here as a neutral setting in config/git/config.
  local allowed_signers
  allowed_signers="$(_allowed_signers_path)"
  if [[ -f "$pubkey" ]]; then
    touch "$allowed_signers"
    # Take only keytype+keydata (drop the trailing comment) so the principal binds to
    # exactly one key regardless of the .pub file's comment.
    local keytype keydata signer_line
    read -r keytype keydata _ <"$pubkey"
    signer_line="$email $keytype $keydata"
    if ! grep -qF "$signer_line" "$allowed_signers"; then
      printf '%s\n' "$signer_line" >>"$allowed_signers"
    fi
  fi

  # hasconfig include that binds this email to the alias (idempotent append).
  local identities="$HOME/.gitconfig-identities"
  touch "$identities"
  # `*/**` (not the bare `:**` the design sketched) is required: git's hasconfig glob
  # only lets `**` cross a `/` when slash-delimited, so `:**` never matches an scp URL's
  # owner/repo path. `*/**` matches owner/repo, owner/team/repo, and .git-less forms.
  local includeif="[includeIf \"hasconfig:remote.*.url:git@${alias}:*/**\"]"
  if ! grep -qF "$includeif" "$identities"; then
    {
      printf '%s\n' "$includeif"
      printf '\tpath = ~/.gitconfig-%s\n' "$name"
    } >>"$identities"
  fi

  log_success "Identity slot '$name' ready — remote-bound to $alias, commits SSH-signed"
  log_info "email: $email — commits in repos whose remote uses $alias are authored and signed as this slot"

  if [[ -f "$pubkey" ]]; then
    # Auto-register the slot key on the host as auth + signing. register-key
    # uploads to the host CLI's *currently authenticated* account (falling back to
    # print-and-paste when none is), so for a distinct client account make that
    # account the active gh/glab login before running add-identity.
    git_register_key --host "$host" --key "$keypath" --name "$name"
  else
    log_warning "No public key found at $pubkey — register the matching public key on the $host account as both an Authentication and a Signing key."
  fi
}

git_remove_identity() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    log_error "Usage: $command_name remove-identity <slot>"
    return 1
  fi

  local alias
  if ! alias="$(git_slot_alias_for_name "$name")" || [[ -z "$alias" ]]; then
    log_error "No identity slot '$name' to remove."
    return 1
  fi
  local host="${alias%-"$name"}" # alias is <host>-<name>

  fmt_title_underline "Tearing down identity slot: $name"

  local fragment="$HOME/.gitconfig-$name"
  local email signingkey privkey managed_privkey
  email="$(git config -f "$fragment" user.email 2>/dev/null || true)"
  signingkey="$(git config -f "$fragment" user.signingkey 2>/dev/null || true)"
  privkey="${signingkey%.pub}"
  managed_privkey="$HOME/.ssh/id_ed25519_$name"

  local ssh_config="$HOME/.ssh/config"
  [[ -f "$ssh_config" ]] && ssh_config_drop_alias "$ssh_config" "$alias"

  local identities="$HOME/.gitconfig-identities"
  [[ -f "$identities" ]] && identities_drop_alias "$identities" "$alias"

  local allowed_signers
  allowed_signers="$(_allowed_signers_path)"
  if [[ -f "$allowed_signers" && -n "$email" ]]; then
    local tmp
    tmp="$(mktemp)"
    awk -v e="$email" '$1 != e' "$allowed_signers" >"$tmp"
    mv "$tmp" "$allowed_signers"
  fi

  rm -f "$fragment"

  if [[ -n "$privkey" ]]; then
    if [[ "$privkey" == "$managed_privkey" ]]; then
      rm -f "$privkey" "$privkey.pub"
    else
      log_warning "External key preserved (adopted, not managed by this slot): $privkey — delete it manually if it's no longer needed."
    fi
  fi

  local gitdir repo url token
  while IFS= read -r gitdir; do
    [[ -n "$gitdir" ]] || continue
    repo="${gitdir%/.git}"
    url="$(git -C "$repo" config --get remote.origin.url 2>/dev/null || true)"
    [[ -n "$url" ]] || continue
    token="$(git_url_host_token "$url" 2>/dev/null || true)"
    if [[ "$token" == "$alias" ]]; then
      log_warning "~${repo#"$HOME"} still points at $alias — rebind it (dot git use <slot>) before the slot's key is gone for good."
    fi
  done < <(git_slot_audit_dirs)

  log_success "Identity slot '$name' removed."
  log_info "If it's no longer needed, revoke this slot's key from the $host account for $alias."
}

# Extract owner/repo (keeping any trailing .git) from an origin URL, handling
# HTTPS, ssh://, and scp-style (incl. already-aliased) forms. Prints owner/repo;
# returns 1 on an unrecognized URL.
origin_owner_repo() {
  local url="$1" rest
  case "$url" in
    https://* | http://*)
      rest="${url#*://}" # host/owner/repo.git
      printf '%s\n' "${rest#*/}"
      ;;
    ssh://*)
      rest="${url#ssh://}" # [user@]host[:port]/owner/repo.git
      rest="${rest#*@}"    # drop user@ if present
      printf '%s\n' "${rest#*/}"
      ;;
    *:*)
      # scp-style: [user@]host:owner/repo.git (host alias never contains a colon).
      printf '%s\n' "${url#*:}"
      ;;
    *)
      return 1
      ;;
  esac
}

# Rebind a repo's origin to a slot's alias — the DURABLE, git-side half of
# `dot git use`, shared with `dot git migrate` (which does only this; it never
# touches the global `gh` account). Given a repo dir and a slot NAME, resolves
# the alias, rewrites origin to git@<alias>:owner/repo, and prints the new URL.
# Emits no logging so each caller frames its own messages; on failure it touches
# nothing and returns a distinct code:
#   3  unknown slot   4  no origin remote   5  unparseable origin URL
bind_repo_to_slot() {
  local repo_dir="$1" name="$2" alias url ownerrepo newurl
  alias="$(git_slot_alias_for_name "$name")" || return 3
  [[ -n "$alias" ]] || return 3
  url="$(git -C "$repo_dir" remote get-url origin 2>/dev/null)" || return 4
  [[ -n "$url" ]] || return 4
  ownerrepo="$(origin_owner_repo "$url")" || return 5
  [[ -n "$ownerrepo" ]] || return 5
  newurl="git@${alias}:${ownerrepo}"
  git -C "$repo_dir" remote set-url origin "$newurl" || return 1
  printf '%s\n' "$newurl"
}

# Verify a bind: print a success/warning line comparing the repo's resolved
# user.email against the slot fragment's. Shared by `use` and `migrate`.
_report_bind() {
  local repo_dir="$1" name="$2" newurl="$3" label="$4" slot_email resolved
  slot_email="$(git config -f "$HOME/.gitconfig-$name" user.email 2>/dev/null || true)"
  resolved="$(git -C "$repo_dir" config user.email 2>/dev/null || true)"
  if [[ -n "$slot_email" && "$resolved" == "$slot_email" ]]; then
    log_success "$label — origin is $newurl, commits authored/signed as $resolved"
  else
    log_warning "origin rewritten to $newurl, but user.email resolved to '${resolved:-<unset>}' (expected '${slot_email:-<unknown>}')"
  fi
}

git_use() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    log_error "Usage: $command_name use <slot>"
    return 1
  fi

  if ! command -v git &>/dev/null; then
    log_error "Git is not installed."
    return 1
  fi

  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    log_error "Not inside a git repository — run 'dot git use' from a repo."
    return 1
  fi

  local repo
  repo="$(git rev-parse --show-toplevel 2>/dev/null || printf '.')"

  # Resolve the alias up front for the gh-switch host and precise error text
  # (bind_repo_to_slot is silent; it re-resolves internally).
  local alias
  if ! alias="$(git_slot_alias_for_name "$name")" || [[ -z "$alias" ]]; then
    log_error "No identity slot '$name' — create it first with: $command_name add-identity --name $name --host <host> --email <email>"
    return 1
  fi
  local host="${alias%-"$name"}" # alias is <host>-<name>

  local newurl rc=0
  newurl="$(bind_repo_to_slot "$repo" "$name")" || rc=$?
  case "$rc" in
    0) ;;
    4)
      log_error "No 'origin' remote in this repository — add one, then re-run: $command_name use $name"
      return 1
      ;;
    5)
      log_error "Could not parse owner/repo from origin URL: $(git -C "$repo" remote get-url origin 2>/dev/null || true)"
      return 1
      ;;
    *)
      log_error "Could not bind this repo to slot '$name'."
      return 1
      ;;
  esac

  _report_bind "$repo" "$name" "$newurl" "Bound this repo to slot '$name'"

  # gh account sync: GitHub-only, and only when a gh CLI and a slot github user
  # are both present. Never fail the whole command if the switch fails — the
  # git-side bind already succeeded.
  case "$host" in
    github.com | github.*)
      local slot_ghuser
      slot_ghuser="$(git_slot_ghuser "$name" || true)"
      if ! command -v gh &>/dev/null; then
        log_info "gh not found — skipping GitHub account switch (git identity is already bound)."
      elif [[ -z "$slot_ghuser" ]]; then
        log_info "Slot '$name' has no github.user — skipping gh account switch."
      elif gh auth switch --hostname "$host" --user "$slot_ghuser" >/dev/null 2>&1; then
        log_success "Switched active gh account to '$slot_ghuser' on $host."
      else
        log_warning "Could not switch gh account to '$slot_ghuser' on $host — run 'gh auth switch --user $slot_ghuser' manually."
      fi
      ;;
  esac
}

# Interactive, one-pass onboarding of EXISTING repos onto slots. Walks the same
# repos `dot doctor` audits (git_slot_audit_dirs) and, per mis-set repo:
#   misset-use  a slot exists for the host -> prompt (default yes), then bind
#               the durable git-side remote (reusing bind_repo_to_slot).
#   misset-add  no slot for the host -> print the add-identity remedy and skip.
# Everything else (bound / no-origin / unknown / unparseable) is left untouched.
# Migrate does the git-side rebind ONLY — it never runs `gh auth switch`, because
# the active gh account is a single global and thrashing it across many repos is
# wrong; gh aligns later when you `dot git use` (or work) in a specific repo.
# Re-runnable and non-destructive: the only change ever made is a remote rewrite,
# and an already-bound repo classifies as `bound` so a second pass offers nothing.
git_migrate() {
  if ! command -v git &>/dev/null; then
    log_error "Git is not installed."
    return 1
  fi

  fmt_title_underline "Migrating repos onto identity slots"
  log_info "Scanning repos under the audit roots. Migrate rebinds the git remote only —"
  log_info "run 'dot git use <slot>' in a repo later to also align its gh account."

  # The repo stream is on fd 3, NOT stdin: the per-repo prompt's `read` must draw
  # from the real stdin (the user's answers), not consume the dir list.
  local gitdir repo url status kind rest slot host newurl reply rc
  local bound=0 skipped=0 needs_add=0
  while IFS= read -r gitdir <&3; do
    [[ -n "$gitdir" ]] || continue
    repo="${gitdir%/.git}"
    url="$(git -C "$repo" config --get remote.origin.url 2>/dev/null || true)"
    [[ -n "$url" ]] || continue # no origin (scratch) -> skip silently
    status="$(git_slot_status "$url")"
    kind="${status%%:*}"
    case "$kind" in
      misset-use)
        rest="${status#misset-use:}"
        slot="${rest%%:*}"
        host="${rest#*:}"
        printf '\n'
        log_info "repo:   ~${repo#"$HOME"}"
        log_info "origin: $url"
        log_info "slot:   $slot ($host)"
        reply=""
        read -rp "Bind this repo to slot '$slot'? [Y/n] " reply || reply=""
        case "$reply" in
          [Nn] | [Nn][Oo])
            log_info "skipped ~${repo#"$HOME"} (unchanged)"
            skipped=$((skipped + 1))
            ;;
          *)
            rc=0
            newurl="$(bind_repo_to_slot "$repo" "$slot")" || rc=$?
            if [[ "$rc" -eq 0 && -n "$newurl" ]]; then
              _report_bind "$repo" "$slot" "$newurl" "Bound ~${repo#"$HOME"} to slot '$slot'"
              bound=$((bound + 1))
            else
              log_warning "Could not rebind ~${repo#"$HOME"} — left unchanged"
              skipped=$((skipped + 1))
            fi
            ;;
        esac
        ;;
      misset-add)
        host="${status#misset-add:}"
        log_warning "~${repo#"$HOME"} on $host has no slot — create one first, then re-run migrate:"
        log_info "  $command_name add-identity --name <slot> --host $host --email <you@example.com>"
        needs_add=$((needs_add + 1))
        ;;
      *) : ;; # none | bound | unknown | unparseable -> leave untouched
    esac
  done 3< <(git_slot_audit_dirs)

  printf '\n'
  log_success "migrate complete — bound $bound, skipped $skipped, need add-identity $needs_add"
}

# Activate the Identity Guard: point core.hooksPath at the committed hook directory.
# The path is machine-specific and absolute, so it goes in ~/.gitconfig-local — never
# in the committed config/git/config (which is shared across machines).
git_install_guard() {
  if ! command -v git &>/dev/null; then
    log_error "Git is not installed."
    return 1
  fi

  local hook_dir="$DOTFILES/config/git/hooks"
  if [[ ! -d "$hook_dir" ]]; then
    log_error "Hook directory not found: $hook_dir"
    return 1
  fi
  hook_dir="$(cd "$hook_dir" && pwd -P)"

  if [[ ! -x "$hook_dir/pre-commit" ]]; then
    log_error "Guard hook missing or not executable: $hook_dir/pre-commit"
    return 1
  fi

  git config -f "$HOME/.gitconfig-local" core.hooksPath "$hook_dir"
  log_success "Identity Guard installed — core.hooksPath -> $hook_dir"
  log_info "Written to ~/.gitconfig-local (machine-local, not committed)."
}

main() {
  if [ $# -lt 1 ]; then
    usage
    exit 0
  fi

  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    setup)
      setup_git
      ;;
    add-identity)
      shift
      git_add_identity "$@"
      ;;
    use)
      shift
      git_use "$@"
      ;;
    register-key)
      shift
      git_register_key "$@"
      ;;
    migrate)
      shift
      git_migrate "$@"
      ;;
    remove-identity)
      shift
      git_remove_identity "$@"
      ;;
    install-guard)
      shift
      git_install_guard "$@"
      ;;
    *)
      log_error "Unknown legacy command: $1"
      echo -e
      usage
      exit 1
      ;;
  esac
}

# Only run when executed directly; sourcing for tests must not run main.
if [[ "${BASH_SOURCE[0]:-$0}" == "${0}" ]]; then
  main "$@"
fi
