#!/usr/bin/env bash
# Description: Check if all required tools are installed and healthy

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
source "$DOTFILES/bin/lib/common.sh"
# shellcheck disable=SC1091
source "$DOTFILES/bin/lib/profile.sh"
# shellcheck disable=SC1091
source "$DOTFILES/bin/lib/brew.sh"
# shellcheck disable=SC1091
source "$DOTFILES/bin/lib/links.sh"
# Drift summary (shared with dot-reconcile) — bash-3.2-safe, read-only scans.
# shellcheck disable=SC1091
source "$DOTFILES/bin/lib/reconcile.sh"
# Identity-slot detection (shared with the Identity Guard) — the mis-set check.
# shellcheck disable=SC1091
source "$DOTFILES/bin/lib/git-slots.sh"
# Repo discovery for the identity audit (shared with `dot git migrate`).
# shellcheck disable=SC1091
source "$DOTFILES/bin/lib/git-repo-discovery.sh"

missing_count=0
optional_missing=0

# Map a brew formula to its binary name for the few that differ. A case function,
# not an associative array (`declare -A`): assoc arrays are a bash 4+ feature and
# crash under macOS system bash 3.2, which is what runs on a fresh Mac.
brew_cmd_for() {
  case "$1" in
    neovim) echo "nvim" ;;
    ripgrep) echo "rg" ;;
    git-delta) echo "delta" ;;
    httpie) echo "http" ;;
    gnupg) echo "gpg" ;;
    python) echo "python3" ;;
    tflint-ruby/tflint/tflint) echo "tflint" ;;
    *) echo "$1" ;;
  esac
}

check_tool() {
  local name="$1"
  local cmd="${2:-$1}"
  local required="${3:-true}"

  if command -v "$cmd" &>/dev/null; then
    local version
    version=$("$cmd" --version 2>/dev/null | head -n1 | sed 's/\x1b\[[0-9;]*m//g') || version=""
    [[ -z "$version" ]] && version="installed"
    printf "  %b %b%-14s%b %b%s%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "$name" "$RESET" "$DIM" "$version" "$RESET"
  else
    if [[ "$required" == "true" ]]; then
      printf "  %b %b%-14s%b %b%s%b\n" "${RED}${ERROR_ICON}" "$BOLD" "$name" "$RESET" "$RED" "not found" "$RESET"
      missing_count=$((missing_count + 1))
    else
      printf "  %b %b%-14s%b %b%s%b\n" "${YELLOW}${WARNING_ICON}" "$BOLD" "$name" "$RESET" "$YELLOW" "not found (optional)" "$RESET"
      optional_missing=$((optional_missing + 1))
    fi
  fi
}

check_sdkman() {
  local sdkman_dir="${SDKMAN_DIR:-$HOME/.sdkman}"
  if [[ -s "$sdkman_dir/bin/sdkman-init.sh" ]]; then
    local version
    version=$(bash -c "source '$sdkman_dir/bin/sdkman-init.sh' && sdk version 2>/dev/null" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1) || version="installed"
    printf "  %b %b%-14s%b %b%s%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "sdkman" "$RESET" "$DIM" "$version" "$RESET"
  else
    printf "  %b %b%-14s%b %b%s%b\n" "${YELLOW}${WARNING_ICON}" "$BOLD" "sdkman" "$RESET" "$YELLOW" "not found (optional)" "$RESET"
    optional_missing=$((optional_missing + 1))
  fi
}

check_sdkman_env() {
  local cfg="${SDKMAN_DIR:-$HOME/.sdkman}/etc/config"
  [[ -f "$cfg" ]] || return 0
  if grep -q '^sdkman_auto_env=true$' "$cfg"; then
    printf "  %b %b%-14s%b %b%s%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "sdkman env" "$RESET" "$DIM" "auto-env on" "$RESET"
  else
    printf "  %b %b%-14s%b %b%s%b\n" "${YELLOW}${WARNING_ICON}" "$BOLD" "sdkman env" "$RESET" "$YELLOW" "auto-env off — run ./setup.sh to enable .sdkmanrc on cd" "$RESET"
    optional_missing=$((optional_missing + 1))
  fi
}

# check_sdk <candidate> <bin> [required] — like check_tool, but also recognizes a
# candidate installed via SDKMAN whose bin isn't on THIS shell's PATH yet (a fresh
# install needs a new shell), so it isn't a false "not found" right after install.
check_sdk() {
  local candidate="$1" bin="${2:-$1}" required="${3:-true}"
  if command -v "$bin" &>/dev/null; then
    check_tool "$candidate" "$bin" "$required"
    return
  fi
  local sdkbin="${SDKMAN_DIR:-$HOME/.sdkman}/candidates/$candidate/current/bin/$bin"
  if [[ -x "$sdkbin" ]]; then
    printf "  %b %b%-14s%b %b%s%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "$candidate" "$RESET" "$DIM" "installed (open a new shell for PATH)" "$RESET"
    return
  fi
  if [[ "$required" == "true" ]]; then
    printf "  %b %b%-14s%b %b%s%b\n" "${RED}${ERROR_ICON}" "$BOLD" "$candidate" "$RESET" "$RED" "not found" "$RESET"
    missing_count=$((missing_count + 1))
  else
    printf "  %b %b%-14s%b %b%s%b\n" "${YELLOW}${WARNING_ICON}" "$BOLD" "$candidate" "$RESET" "$YELLOW" "not found (optional)" "$RESET"
    optional_missing=$((optional_missing + 1))
  fi
}

# Pure: classify SSH-to-host state from a key path and a precomputed auth bool.
# Host-neutral (the caller supplies the auth result) — shared by the GitHub and
# GitLab checks. Prints one of: missing | ok | untrusted | auth-fail.
_ssh_host_status() {
  local key="${1:-}" auth_ok="${2:-false}"
  if [[ ! -f "$key" ]]; then
    printf '%s\n' "missing"
    return 0
  fi
  case "$auth_ok" in
    true)
      printf '%s\n' "ok"
      return 0
      ;;
    untrusted)
      printf '%s\n' "untrusted"
      return 1
      ;;
    *)
      printf '%s\n' "auth-fail"
      return 1
      ;;
  esac
}

# Pure: should doctor run its GitLab SSH check? Yes when glab is authenticated OR
# a gitlab.com slot exists — silent on pure-GitHub machines. Report-only either way.
_gitlab_ssh_check_enabled() {
  local glab_authed="${1:-false}" has_gitlab_slot="${2:-false}"
  [[ "$glab_authed" == "true" || "$has_gitlab_slot" == "true" ]]
}

# Pure: classify a captured `ssh -T` output string into an auth-state token —
# true | untrusted | false. Extracted so each forge's success/failure phrasing is
# unit-testable (the live ssh call in check_ssh_host is the thin wrapper).
_ssh_auth_from_output() {
  local out="$1"
  # GitHub says "...successfully authenticated..."; GitLab says "Welcome to
  # GitLab, @user!" — match either so the shared check works for both forges.
  if grep -qiE "successfully authenticated|welcome to gitlab" <<<"$out"; then
    printf 'true\n'
  elif grep -qiE "host key verification failed|no matching host key|known_hosts" <<<"$out"; then
    # Fresh machine: the host isn't trusted yet, so BatchMode ssh can't accept the
    # fingerprint — NOT a key/auth problem. Report it as its own state.
    printf 'untrusted\n'
  else
    printf 'false\n'
  fi
}

# Live check: a present key the host rejects is the half-configured state that
# silently breaks pushes. `ssh -T git@<host>` exits non-zero (the forge never
# opens a shell); classify by OUTPUT, not exit code. Host-parameterized so
# GitHub and GitLab share one body.
check_ssh_host() {
  local host="$1" label="$2" add_hint="$3"
  local key="$HOME/.ssh/id_ed25519" auth_ok="false" status out
  if [[ -f "$key" ]]; then
    # Capture first to dodge the pipefail trap: `ssh | grep` returns ssh's
    # non-zero even when grep matched, so auth would never register as ok.
    out="$(ssh -T -o BatchMode=yes -o ConnectTimeout=5 "git@$host" 2>&1 || true)"
    auth_ok="$(_ssh_auth_from_output "$out")"
  fi
  status="$(_ssh_host_status "$key" "$auth_ok")" || true
  case "$status" in
    ok)
      printf "  %b %b%-14s%b %b%s%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "$label" "$RESET" "$DIM" "authenticated" "$RESET"
      ;;
    missing)
      printf "  %b %b%-14s%b %b%s%b\n" "${YELLOW}${WARNING_ICON}" "$BOLD" "$label" "$RESET" "$YELLOW" "no key — run ./setup.sh (optional)" "$RESET"
      optional_missing=$((optional_missing + 1))
      ;;
    untrusted)
      printf "  %b %b%-14s%b %b%s%b\n" "${YELLOW}${WARNING_ICON}" "$BOLD" "$label" "$RESET" "$YELLOW" "$host host key not trusted — run ./setup.sh (or: ssh-keyscan $host >> ~/.ssh/known_hosts)" "$RESET"
      optional_missing=$((optional_missing + 1))
      ;;
    *)
      printf "  %b %b%-14s%b %b%s%b\n" "${RED}${ERROR_ICON}" "$BOLD" "$label" "$RESET" "$RED" "key present but auth fails — add it: $add_hint" "$RESET"
      optional_missing=$((optional_missing + 1))
      ;;
  esac
}

check_profile() {
  local profile runtime
  profile="$(dot_profile)"
  runtime="$(dot_docker_runtime)"
  printf "  %b %b%-14s%b %b%s%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "profile" "$RESET" "$DIM" "$profile" "$RESET"
  printf "  %b %b%-14s%b %b%s%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "docker runtime" "$RESET" "$DIM" "$runtime" "$RESET"
}

check_docker_runtime() {
  local runtime installed=false
  runtime="$(dot_docker_runtime)"
  case "$runtime" in
    docker-desktop)
      if { command -v brew &>/dev/null && brew list --cask docker-desktop &>/dev/null; } || [[ -d "/Applications/Docker.app" ]]; then
        installed=true
      fi
      ;;
    rancher)
      if { command -v brew &>/dev/null && brew list --cask rancher &>/dev/null; } || [[ -d "/Applications/Rancher Desktop.app" ]]; then
        installed=true
      fi
      ;;
    colima)
      if command -v colima &>/dev/null; then
        installed=true
      fi
      ;;
    *)
      printf "  %b %b%-14s%b %b%s%b\n" "${YELLOW}${WARNING_ICON}" "$BOLD" "${runtime:-<unset>}" "$RESET" "$YELLOW" "unknown runtime" "$RESET"
      optional_missing=$((optional_missing + 1))
      return 0
      ;;
  esac

  if [[ "$installed" == true ]]; then
    printf "  %b %b%-14s%b %b%s%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "$runtime" "$RESET" "$DIM" "installed" "$RESET"
  else
    printf "  %b %b%-14s%b %b%s%b\n" "${YELLOW}${WARNING_ICON}" "$BOLD" "$runtime" "$RESET" "$YELLOW" "not found (optional)" "$RESET"
    optional_missing=$((optional_missing + 1))
  fi
}

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

check_config_links() {
  local issues=0
  local source target label name
  while IFS=$'\t' read -r source target label; do
    name=$(basename "$source")
    case "$(classify_link "$source" "$target")" in
      ok)
        printf "  %b %b%-22s%b %blinked%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "$name" "$RESET" "$DIM" "$RESET"
        ;;
      wrong)
        printf "  %b %b%-22s%b %bwrong target → %s%b\n" "${RED}${ERROR_ICON}" "$BOLD" "$name" "$RESET" "$RED" "$(readlink "$target")" "$RESET"
        log_info "    Fix: dot link $name --force"
        issues=$((issues + 1))
        ;;
      real)
        printf "  %b %b%-22s%b %breal file/dir (not a symlink)%b\n" "${YELLOW}${WARNING_ICON}" "$BOLD" "$name" "$RESET" "$YELLOW" "$RESET"
        log_info "    Fix: dot backup && dot link $name --force"
        issues=$((issues + 1))
        ;;
      missing)
        printf "  %b %b%-22s%b %bnot linked%b\n" "${RED}${ERROR_ICON}" "$BOLD" "$name" "$RESET" "$RED" "$RESET"
        log_info "    Fix: dot link $name"
        issues=$((issues + 1))
        ;;
    esac
  done < <(managed_targets config)
  return "$issues"
}

check_home_links() {
  local issues=0
  local source target label
  while IFS=$'\t' read -r source target label; do
    case "$(classify_link "$source" "$target")" in
      ok)
        printf "  %b %b%-22s%b %blinked%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "$label" "$RESET" "$DIM" "$RESET"
        ;;
      wrong)
        printf "  %b %b%-22s%b %bwrong target%b\n" "${RED}${ERROR_ICON}" "$BOLD" "$label" "$RESET" "$RED" "$RESET"
        issues=$((issues + 1))
        ;;
      real)
        printf "  %b %b%-22s%b %breal file (not a symlink)%b\n" "${YELLOW}${WARNING_ICON}" "$BOLD" "$label" "$RESET" "$YELLOW" "$RESET"
        issues=$((issues + 1))
        ;;
      seeded)
        # A Seed Target's present live file is the healthy state — the tool owns
        # it (ADR-0008), so it is not a link issue.
        printf "  %b %b%-22s%b %bseeded (app-owned)%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "$label" "$RESET" "$DIM" "$RESET"
        ;;
      missing)
        printf "  %b %b%-22s%b %bnot linked%b\n" "${RED}${ERROR_ICON}" "$BOLD" "$label" "$RESET" "$RED" "$RESET"
        issues=$((issues + 1))
        ;;
    esac
  done < <(managed_targets home)
  return "$issues"
}

# Dangling links whose repo source is gone — the shared reconcile scan covers
# removed config packages AND deleted home files (git-history derived, #21),
# which the old depth-1 config scan never saw. Paths shown ~/-relative: home
# dangles like ~/.claude/settings.json aren't unambiguous by basename.
check_stale_links() {
  local issues=0
  local stale
  while IFS= read -r stale; do
    [ -n "$stale" ] || continue
    printf "  %b %b%-22s%b %bstale → %s%b\n" "${RED}${ERROR_ICON}" "$BOLD" "~${stale#"$HOME"}" "$RESET" "$RED" "$(readlink "$stale")" "$RESET"
    log_info "    Fix: dot clean"
    issues=$((issues + 1))
  done < <(reconcile_symlinks_dangling)
  return "$issues"
}

check_default_shell() {
  local current_shell
  current_shell=$(dscl . -read ~/ UserShell 2>/dev/null | awk '{print $2}')
  if [[ "$current_shell" == *zsh ]]; then
    printf "  %b %b%-22s%b %b%s%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "default shell" "$RESET" "$DIM" "$current_shell" "$RESET"
  else
    printf "  %b %b%-22s%b %b%s (expected zsh)%b\n" "${RED}${ERROR_ICON}" "$BOLD" "default shell" "$RESET" "$RED" "$current_shell" "$RESET"
    log_info "    Fix: dot shell change"
    return 1
  fi
}

check_zsh_plugins() {
  local plugin_dir="${ZPLUGDIR:-$HOME/.local/share/zsh/plugins}"
  local expected_plugins=(
    "zsh-users/zsh-completions"
    "zsh-users/zsh-syntax-highlighting"
    "zsh-users/zsh-autosuggestions"
    "zsh-users/zsh-history-substring-search"
    "MichaelAquilina/zsh-you-should-use"
    "Aloxaf/fzf-tab"
    "junegunn/fzf-git.sh"
  )
  local issues=0
  for plugin in "${expected_plugins[@]}"; do
    local name dir
    name=$(basename "$plugin")
    dir="$plugin_dir/$plugin"
    if [ -d "$dir/.git" ] || [ -d "$dir" ]; then
      printf "  %b %b%-22s%b %binstalled%b\n" "${GREEN}${SUCCESS_ICON}" "$BOLD" "$name" "$RESET" "$DIM" "$RESET"
    else
      printf "  %b %b%-22s%b %bnot installed%b\n" "${RED}${ERROR_ICON}" "$BOLD" "$name" "$RESET" "$RED" "$RESET"
      issues=$((issues + 1))
    fi
  done
  if [ "$issues" -gt 0 ]; then
    log_info "    Fix: open a new shell to auto-install plugins"
  fi
  return "$issues"
}

# --- identity audit --------------------------------------------------------
# Report-only proactive sweep (the Identity Guard is the correctness mechanism):
# scan conventional roots for git repos whose origin is mis-set against its slot,
# and warn on gh-account drift. Performs NO writes; non-gating like the Drift
# section (informational, --strict included).

# Repo discovery (roots + `.git` walk) is shared with `dot git migrate` via
# git-slots.sh (git_slot_audit_roots / git_slot_audit_dirs) so the sweep and the
# interactive onboarding can never scan a different set of repos.

check_identity_audit() {
  if ! command -v git &>/dev/null; then
    log_info "git not found — skipping identity audit"
    return 0
  fi

  local gitdir repo url status kind rest slot host name ghuser
  local issues=0 gh_active="" gh_probed=0 last_gh_dir="" last_gh_login=""
  while IFS= read -r gitdir; do
    [[ -n "$gitdir" ]] || continue
    repo="${gitdir%/.git}"
    url="$(git -C "$repo" config --get remote.origin.url 2>/dev/null || true)"
    [[ -n "$url" ]] || continue # no origin (scratch) -> fine
    status="$(git_slot_status "$url")"
    kind="${status%%:*}"
    case "$kind" in
      misset-use)
        rest="${status#misset-use:}"
        slot="${rest%%:*}"
        host="${rest#*:}"
        log_warning "identity: ~${repo#"$HOME"} on $host is not bound to a slot — run: dot git use $slot"
        issues=$((issues + 1))
        ;;
      misset-add)
        host="${status#misset-add:}"
        log_warning "identity: ~${repo#"$HOME"} on $host has no slot — run: dot git add-identity --name <slot> --host $host --email <you@example.com> && dot git use <slot>"
        issues=$((issues + 1))
        ;;
      bound)
        # Already on a slot alias. Only GitHub slots have a gh account to drift.
        local alias_bound="${status#bound:}"
        case "$alias_bound" in
          github.com-* | github.*-*) ;;
          *) continue ;;
        esac
        command -v gh &>/dev/null || continue
        name="$(git_slot_name_for_alias "$alias_bound" 2>/dev/null || true)"
        [[ -n "$name" ]] || continue
        ghuser="$(git_slot_ghuser "$name" || true)"
        [[ -n "$ghuser" ]] || continue
        # A dedicated per-slot gh config (~/.config/gh-<name>) makes the gh()
        # wrapper resolve this repo's account correctly on its own — check
        # THAT login instead of the single global active account, which the
        # wrapper's presence makes an unreliable signal for this slot.
        local gh_dir
        if gh_dir="$(git_slot_gh_config_dir "$name" 2>/dev/null)"; then
          if [[ "$gh_dir" != "$last_gh_dir" ]]; then
            last_gh_login="$(GH_CONFIG_DIR="$gh_dir" gh api user --jq .login 2>/dev/null || true)"
            last_gh_dir="$gh_dir"
          fi
          if [[ -n "$last_gh_login" && "$last_gh_login" != "$ghuser" ]]; then
            log_warning "gh drift: ~${repo#"$HOME"} expects gh account $ghuser, its dedicated config ($gh_dir) is authenticated as $last_gh_login"
            issues=$((issues + 1))
          fi
          continue
        fi
        # No dedicated per-slot config yet -- fall back to the single global
        # active account (read once; it's the same account for every host).
        if [[ "$gh_probed" -eq 0 ]]; then
          gh_active="$(gh api user --jq .login 2>/dev/null || true)"
          gh_probed=1
        fi
        [[ -n "$gh_active" ]] || continue
        if [[ "$gh_active" != "$ghuser" ]]; then
          log_warning "gh drift: ~${repo#"$HOME"} expects gh account $ghuser, active is $gh_active (no dedicated config yet — see: GH_CONFIG_DIR=$HOME/.config/gh-$name gh auth login)"
          issues=$((issues + 1))
        fi
        ;;
      *) : ;; # none | unparseable | unknown -> fine
    esac
  done < <(git_slot_audit_dirs)

  if [[ "$issues" -eq 0 ]]; then
    log_success "no identity or gh-account drift across audited repos"
  else
    log_info "The Identity Guard blocks mis-set commits; the fixes above clear the warnings."
  fi
  return 0
}

# --- config leaks -----------------------------------------------------------
# config/*/home/* are symlinked from $HOME back into the repo's own working
# tree, so a tool writing runtime/generated state into $HOME/.config/<pkg>/...
# creates an untracked file directly inside the repo (e.g. git's
# allowed_signers, #58). Detection is just `git status` over those paths — the
# repo's own .gitignore is the false-positive carve-out, for free. Report-only,
# non-gating like the Drift and Identity Audit sections (--strict included):
# there is no "missing" counterpart to a leak, so this has no exit-code role.

check_config_leaks() {
  if ! command -v git &>/dev/null; then
    log_info "git not found — skipping config-leak scan"
    return 0
  fi

  local leaks
  leaks="$(git -C "$DOTFILES" status --porcelain --untracked-files=normal -- config/ home/ 2>/dev/null || true)"

  if [[ -z "$leaks" ]]; then
    log_success "no config leaks in config/ or home/"
    return 0
  fi

  local line path
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    path="${line:3}"
    log_warning "config leak: $path (untracked file inside a symlinked dir)"
  done <<<"$leaks"
  log_info "A leaked file is runtime/generated state a tool wrote into its own symlinked config dir — relocate it out of config/home, or add a .gitignore entry if it's expected."
  return 0
}

main() {
  local strict=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --strict)
        strict=true
        shift
        ;;
      -h | --help)
        printf 'Usage: dot doctor [--strict]\n  --strict  treat every warning (optional tools, etc.) as a failure\n\nThe Git Identity section audits repos under ~/work ~/workspace ~/dev ~/dotfiles\n~/personal ~/clients (plus any dirs set via dot profile set-config git_audit_roots,\nwhich augment the defaults) and warns on slot mismatches and gh-account drift.\nIt is report-only and never affects the exit code.\n'
        exit 0
        ;;
      *)
        log_error "Unknown option: $1 (try: dot doctor --strict)"
        exit 1
        ;;
    esac
  done

  fmt_title_border "Dotfiles Health Check"
  echo

  # Machine profile
  fmt_title_underline "Profile"
  check_profile
  echo

  local config_issues=0

  # Config health
  fmt_title_underline "Config Links"
  check_config_links || config_issues=$((config_issues + $?))
  check_home_links || config_issues=$((config_issues + $?))
  check_stale_links || config_issues=$((config_issues + $?))
  echo

  # Shell health
  fmt_title_underline "Shell"
  check_default_shell || config_issues=$((config_issues + 1))
  check_zsh_plugins || config_issues=$((config_issues + $?))
  echo

  # Homebrew packages (auto-derived from brew bundles)
  fmt_title_underline "Homebrew Packages"
  check_tool "brew" "brew"

  # Formulas to skip (system-provided or no user-facing binary)
  local brew_skip=" bash zsh grep font-symbols-only-nerd-font "

  # Required tools (everything else is optional)
  local required_tools=" git neovim tmux starship fzf fd ripgrep zoxide bat eza gh lazygit git-delta jq pre-commit "

  local -a brewfiles=()
  local bf
  # shellcheck disable=SC2119  # dot_brewfiles takes an optional profile arg; calling with no arg is intentional
  while IFS= read -r bf; do
    [[ -f "$bf" ]] && brewfiles+=("$bf")
  done < <(dot_brewfiles)

  if [[ "${#brewfiles[@]}" -gt 0 ]]; then
    while IFS= read -r formula; do
      [[ "$brew_skip" == *" $formula "* ]] && continue
      local cmd
      cmd="$(brew_cmd_for "$formula")"
      # Tap-qualified formulas (containing '/') use the binary as display name
      local name="$formula"
      [[ "$formula" == */* ]] && name="$cmd"
      local required="false"
      [[ "$required_tools" == *" $name "* ]] && required="true"
      check_tool "$name" "$cmd" "$required"
    done < <(reconcile_brew_declared_formulas)
  else
    log_warning "No Brewfiles found under $DOTFILES/brew/"
  fi
  check_docker_runtime
  echo

  # Java / Backend (external to Homebrew)
  fmt_title_underline "Java / Backend"
  check_sdkman
  check_sdkman_env
  check_sdk "java" "java" "true"
  check_sdk "gradle" "gradle" "true"
  check_sdk "maven" "mvn" "true"
  check_sdk "mvnd" "mvnd" "true"
  check_sdk "kotlin" "kotlin" "true"
  echo

  # SSH auth. GitHub is checked unconditionally (it's the dotfiles origin); the
  # GitLab check is gated so pure-GitHub machines stay silent.
  fmt_title_underline "SSH"
  check_ssh_host github.com "ssh github" "dot git register-key --host github.com"
  local glab_authed=false has_gitlab_slot=false
  command -v glab &>/dev/null && glab auth status &>/dev/null && glab_authed=true
  [[ -n "$(git_slots_for_host gitlab.com)" ]] && has_gitlab_slot=true
  if _gitlab_ssh_check_enabled "$glab_authed" "$has_gitlab_slot"; then
    check_ssh_host gitlab.com "ssh gitlab" "dot git register-key --host gitlab.com"
  fi
  echo

  # Git identity audit (report-only sweep; the Identity Guard is the enforcer).
  # Non-gating like Drift — it never affects the exit code, --strict included.
  fmt_title_underline "Git Identity"
  check_identity_audit
  echo

  # Drift vs the repo's declared state (cheap local scans; informational — it
  # never gates the exit code, --strict included; dot reconcile is the detail view)
  fmt_title_underline "Drift"
  local drift_line drift
  drift="$(reconcile_summary 2>/dev/null || true)"
  if [[ -n "$drift" ]]; then
    while IFS= read -r drift_line; do
      log_warning "$drift_line"
    done <<<"$drift"
    log_info "Details & remediation: dot reconcile"
  else
    log_success "machine matches the repo's declared state"
  fi
  echo

  # Config leaks: untracked runtime state a tool wrote into a symlinked
  # config/*/home/* dir (#69). Non-gating like Drift and Identity Audit — it
  # never affects the exit code, --strict included.
  fmt_title_underline "Config Leaks"
  check_config_leaks
  echo

  # Summary
  echo "─────────────────────────────"
  local has_issues=false

  if [[ "$config_issues" -gt 0 ]]; then
    log_warning "$config_issues config/link issue(s) — run: dot link --status"
    has_issues=true
  fi

  if [[ "$missing_count" -gt 0 ]]; then
    log_error "$missing_count required tool(s) missing"
    log_info "Install missing Homebrew packages: dot homebrew bundle"
    log_info "Install Java tools via SDKMAN:     sdk install java"
    has_issues=true
  fi

  [[ "$optional_missing" -gt 0 ]] && log_warning "$optional_missing optional tool(s) missing"

  # --strict: every warning is a failure, for a "must be perfectly green" CI gate.
  if [[ "$strict" == true && "$optional_missing" -gt 0 ]]; then
    log_error "strict: treating $optional_missing warning(s) as failures"
    has_issues=true
  fi

  if [[ "$has_issues" == true ]]; then
    exit 1
  else
    log_success "All checks passed"
  fi
}

# Only run when executed directly; sourcing for tests must not run the health check.
if [[ "${BASH_SOURCE[0]:-$0}" == "${0}" ]]; then
  set -Eeuo pipefail
  main "$@"
fi
