#!/usr/bin/env bash
# Description: Update all the things

set -Eeuo pipefail
DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"

# source helpers
source "$DOTFILES/bin/lib/common.sh"
command_name=$(basename "${BASH_SOURCE[0]}")

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_key "$command_name") $(fmt_value "[options] <command>")

  Update all the things. This script can be used to update Neovim plugins,
  update Homebrew packages, and more.

Options:
    -h, --help           Show this help message
    -v, --verbose        Show verbose output (failed steps print their full
                         log; without it, the last $FAIL_LOG_TAIL_LINES lines)
    nvim, vim            Update Neovim plugins
    homebrew, brew       Update Homebrew packages
    dotfiles             Update dotfiles
    zsh                  Update Zsh plugins
    sdkman               Update SDKMAN and installed SDKs
    all                  Update everything
EOF
}

# Captured-log lines shown when a step fails without --verbose.
FAIL_LOG_TAIL_LINES=15

# surface_step_failure <message> — report a failed step without swallowing the
# cause (issue #18): log <message>, then show the captured output ($RUN_LOG) —
# all of it with --verbose, otherwise the last $FAIL_LOG_TAIL_LINES lines — and
# keep the log file on disk, printing its path for deeper digging.
surface_step_failure() {
  local message="$1"
  log_error "$message"
  if [[ ! -s "$RUN_LOG" ]]; then
    log_info "No output was captured"
    rm -f "$RUN_LOG"
    return 0
  fi
  if [[ "$verbose" == true ]]; then
    cat "$RUN_LOG"
  else
    log_info "Last $FAIL_LOG_TAIL_LINES lines of output:"
    tail -n "$FAIL_LOG_TAIL_LINES" "$RUN_LOG"
  fi
  log_info "Full log kept at: $RUN_LOG"
}

# Pure: classify a `brew update && brew upgrade` run into failed | changed | ok
# from its exit status and captured log. Failure is the EXIT CODE alone — brew's
# chatty output (cask caveats, "Error"/"Failed" substrings) must never flip a
# successful run to failed. "changed" needs a real upgrade marker, not brew's
# always-present "==> Updating Homebrew..." progress header.
_brew_update_outcome() {
  local exit_status="$1" log="$2"
  if [[ "$exit_status" -ne 0 ]]; then
    printf 'failed\n'
  elif grep -qiE '==> upgrad(ing|ed)| -> ' "$log" 2>/dev/null; then
    printf 'changed\n'
  else
    printf 'ok\n'
  fi
}

update_homebrew() {
  fmt_title_underline "Updating Homebrew packages"

  if ! command -v brew &>/dev/null; then
    log_warning "Homebrew is not installed. Skipping..."
    return "$STEP_SKIP_CODE"
  fi

  run_with_spinner "brew update && brew upgrade" 11 "Updating Homebrew"
  local exit_status=$?

  case "$(_brew_update_outcome "$exit_status" "$RUN_LOG")" in
    failed)
      surface_step_failure "Error occurred during update"
      return 1
      ;;
    changed)
      grep -iE '==> upgrad(ing|ed)| -> ' "$RUN_LOG" || true
      rm -f "$RUN_LOG"
      echo -e
      return "$STEP_CHANGED_CODE"
      ;;
    ok)
      log_info "No updates found"
      rm -f "$RUN_LOG"
      echo -e
      ;;
  esac
}

update_nvim_plugins() {
  fmt_title_underline "Updating Neovim plugins"

  if ! command -v nvim &>/dev/null; then
    log_warning "Neovim is not installed. Skipping..."
    return "$STEP_SKIP_CODE"
  fi

  run_with_spinner "nvim --headless '+Lazy! sync' +qa" 11 "Updating Neovim plugins"
  local exit_status=$?

  if [[ $exit_status -ne 0 ]] || grep -q "Error\|ERROR\|Could not\|not installed" "$RUN_LOG"; then
    surface_step_failure "Error occurred during Neovim plugin update"
    return 1
  fi

  local changed=0
  if grep -qi "updated\|installed\|removed" "$RUN_LOG"; then
    grep -i "updated\|installed\|removed" "$RUN_LOG" || true
    changed=1
  else
    log_info "No updates found"
  fi
  rm -f "$RUN_LOG"
  echo -e
  if [[ "$changed" -eq 1 ]]; then return "$STEP_CHANGED_CODE"; fi
}

# Pure: classify a failed `git pull` from its log. The common recoverable case is
# untracked local files colliding with incoming tracked ones (git aborts with
# "untracked working tree files would be overwritten"); everything else is other.
_dotfiles_pull_failed_kind() {
  local log="$1"
  if grep -q "untracked working tree files would be overwritten" "$log" 2>/dev/null; then
    printf 'untracked-collision\n'
  else
    printf 'other\n'
  fi
}

update_dotfiles() {
  fmt_title_underline "Updating dotfiles"

  local current_branch
  current_branch="$(git -C "$DOTFILES" symbolic-ref --short HEAD 2>/dev/null || true)"
  if [ "$current_branch" != "main" ]; then
    log_warning "Not on main branch (current: $current_branch). Skipping dotfiles update."
    return "$STEP_SKIP_CODE"
  fi

  run_with_spinner "git -C '$DOTFILES' fetch --quiet origin main" 11 "Checking for dotfiles updates"
  rm -f "$RUN_LOG"

  local local_rev remote_rev
  local_rev=$(git -C "$DOTFILES" rev-parse HEAD)
  remote_rev=$(git -C "$DOTFILES" rev-parse "@{u}" 2>/dev/null || true)

  if [[ -z "$remote_rev" || "$local_rev" = "$remote_rev" ]]; then
    log_info "Dotfiles are up to date"
    return "$STEP_SKIP_CODE"
  fi

  echo "Updates available:"
  git -C "$DOTFILES" --no-pager log --oneline --graph --decorate --color=always HEAD.."@{u}"

  if run_with_spinner "git -C '$DOTFILES' pull --ff-only origin main" 11 "Updating dotfiles"; then
    log_info "Dotfiles updated successfully"
    rm -f "$RUN_LOG"
    return "$STEP_CHANGED_CODE"
  else
    if [[ "$(_dotfiles_pull_failed_kind "$RUN_LOG")" == "untracked-collision" ]]; then
      log_error "Update blocked: untracked local files collide with incoming tracked files."
      log_info "Back them up and remove them (listed below), then re-run: dot update dotfiles"
    fi
    surface_step_failure "Failed to update dotfiles"
    return 1
  fi
}

update_zsh_plugins() {
  fmt_title_underline "Updating ZSH plugins"

  local plugin_dir="${ZPLUGDIR:-$HOME/.local/share/zsh/plugins}"

  if [[ ! -d "$plugin_dir" ]]; then
    log_warning "No ZSH plugins directory found. Skipping..."
    return "$STEP_SKIP_CODE"
  fi

  local found=false changed=false
  # zfetch clones to $ZPLUGDIR/<org>/<repo>, so plugins live two levels deep
  for dir in "$plugin_dir"/*/*/; do
    [[ -d "$dir/.git" ]] || continue
    found=true

    local name
    name="$(basename "$(dirname "$dir")")/$(basename "$dir")"

    local before
    before=$(git -C "$dir" rev-parse HEAD)

    run_with_spinner "git -C '$dir' pull --quiet --recurse-submodules 2>/dev/null" 11 "Updating $name"
    rm -f "$RUN_LOG"

    local after
    after=$(git -C "$dir" rev-parse HEAD)
    if [[ "$before" != "$after" ]]; then
      changed=true
      local commit_count
      commit_count=$(git -C "$dir" rev-list --count "$before".."$after")
      local commit_msg
      commit_msg=$(git -C "$dir" log -1 --pretty=format:"%s")
      log_success "$name updated ($commit_count new commit(s))"
      printf "  %b→ %s%b\n" "$DIM" "$commit_msg" "$RESET"
    else
      log_info "$name already up to date"
    fi
  done

  if [[ "$found" == false ]]; then
    log_warning "No ZSH plugins installed yet. Open a new shell first."
    return "$STEP_SKIP_CODE"
  fi

  echo -e
  log_success "ZSH Plugin updates completed."
  if [[ "$changed" == true ]]; then return "$STEP_CHANGED_CODE"; fi
}

update_sdkman() {
  fmt_title_underline "Updating SDKMAN"

  local sdkman_dir="${SDKMAN_DIR:-$HOME/.sdkman}"

  if [[ ! -s "$sdkman_dir/bin/sdkman-init.sh" ]]; then
    log_warning "SDKMAN is not installed. Skipping..."
    return "$STEP_SKIP_CODE"
  fi

  # No sdkman_auto_answer=true here: the `sdk` dispatcher re-sources etc/config
  # (sdkman_auto_answer=false, never declared local) on every call, so any export
  # is clobbered before `sdk upgrade` runs — the workaround never worked. The
  # update is non-interactive because run_with_spinner detaches stdin: the
  # "Use prescribed default version(s)?" prompt reads EOF and takes the default.
  run_with_spinner "bash -c 'source \"$sdkman_dir/bin/sdkman-init.sh\" && sdk update 2>&1 && sdk upgrade 2>&1'" 11 "Updating SDKMAN"

  if grep -q "Error\|fatal\|Failed" "$RUN_LOG"; then
    surface_step_failure "Error occurred during SDKMAN update"
    return 1
  fi

  local changed=0
  if grep -qi "updated\|upgraded\|installed" "$RUN_LOG"; then
    grep -i "updated\|upgraded\|installed" "$RUN_LOG" || true
    changed=1
  else
    log_info "All SDKs are up to date"
  fi
  rm -f "$RUN_LOG"
  echo -e
  if [[ "$changed" -eq 1 ]]; then return "$STEP_CHANGED_CODE"; fi
}

main() {
  local subcmd=""
  local verbose=false
  STEP_DRY_RUN=0

  if [ $# -lt 1 ]; then
    usage
    exit 0
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      -v | --verbose)
        verbose=true
        shift
        ;;
      -n | --dry-run)
        STEP_DRY_RUN=1
        shift
        ;;
      *)
        subcmd="$1"
        shift
        ;;
    esac
  done

  step_init

  local -a steps=()
  case "$subcmd" in
    nvim | vim) steps=("Neovim plugins:update_nvim_plugins") ;;
    homebrew | brew) steps=("Homebrew:update_homebrew") ;;
    dotfiles) steps=("dotfiles:update_dotfiles") ;;
    zsh) steps=("ZSH plugins:update_zsh_plugins") ;;
    sdkman) steps=("SDKMAN:update_sdkman") ;;
    all)
      # dotfiles first: pull the source of truth before the long-running steps so
      # a new version is surfaced up front. Note this does NOT re-exec — bash has
      # already parsed every function into memory, so a fresh pull's code takes
      # effect on the *next* run, like any other committed change.
      steps=(
        "dotfiles:update_dotfiles"
        "Neovim plugins:update_nvim_plugins"
        "Homebrew:update_homebrew"
        "ZSH plugins:update_zsh_plugins"
        "SDKMAN:update_sdkman"
      )
      ;;
    *)
      log_error "Unknown $command_name command: $subcmd"
      echo -e
      usage
      exit 1
      ;;
  esac

  local total="${#steps[@]}" idx=0 entry label fn
  for entry in "${steps[@]}"; do
    idx=$((idx + 1))
    label="${entry%%:*}"
    fn="${entry#*:}"
    fmt_step_header "$idx" "$total" "$label"
    step "$label" "$fn"
  done

  step_summary
}

# Only run when executed directly; sourcing for tests must not run main.
if [[ "${BASH_SOURCE[0]:-$0}" == "${0}" ]]; then
  main "$@"
fi
