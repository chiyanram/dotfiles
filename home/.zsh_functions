########################################################
# Navigation
########################################################

c() {
  cd $CODE_DIR/$1
}

_c() {
  _files -W $CODE_DIR -/
}

h() {
  cd $HOME/$1
}

_h() {
  _files -W $HOME -/
}

md() {
  mkdir -p $1
  cd $1
}

prepend_path() {
  [[ ! -d "$1" ]] && return
  path=( $1 $path )
}

########################################################
# Utilities
########################################################

# Copy current working directory to clipboard
cpwd() {
  pwd | sed "s|^${HOME}|~|" | tr -d '\n' | pbcopy
  echo "Copied: $(pbpaste)"
}

# File/directory size
fs() {
  if du -b /dev/null > /dev/null 2>&1; then
    local arg=-sbh
  else
    local arg=-sh
  fi
  if [[ -n "$@" ]]; then
    du ${arg} -- "$@"
  else
    du ${arg} .[^.]* *
  fi
}

# Upgrade all installed SDKMAN candidates.
# Usage: sdkup [-h|--help]
sdkup() {
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: sdkup"
    echo "  Upgrade all installed SDKMAN candidates (runs: sdk upgrade)."
    return 0
  fi
  if ! command -v sdk >/dev/null 2>&1; then
    echo "SDKMAN not available. Open a new shell, or install: curl -s https://get.sdkman.io | bash"
    return 1
  fi
  sdk upgrade
}

# Zsh startup profiler viewer
zshrc_profiler_view() {
  local logfile="$TMPDIR/zshrc_profiler.$$.log"
  if [[ ! -f "$logfile" ]]; then
    # Find most recent profiler log
    logfile=$(ls -t $TMPDIR/zshrc_profiler.*.log 2>/dev/null | head -n1)
  fi
  if [[ -z "$logfile" || ! -f "$logfile" ]]; then
    echo "No profiler log found. Run: touch ~/.zshrc.profiler && exec zsh"
    return 1
  fi
  echo "Top 20 slowest operations:"
  awk '{print $1}' "$logfile" | sort -n | tail -20 | while read time; do
    grep "$time" "$logfile" | head -1
  done
}

########################################################
# Git Functions
########################################################

g() {
  if [[ $# > 0 ]]; then
      git "$@"
  else
      git s
  fi
}

# Auto-select the right gh account for the CURRENT repo, per invocation — no
# global "last dot git use wins" state to race across terminals (the isolation
# gap dotfiles/docs/adr/0001-git-multi-identity-slots.md named and deferred).
# Falls back to gh's own default config untouched when the repo's slot has no
# dedicated GH_CONFIG_DIR yet (bootstrap one: `dot git use <slot>` prints the
# one-time `GH_CONFIG_DIR=... gh auth login` command to run).
gh() {
  local dir
  if dir="$(dot git gh-config-dir 2>/dev/null)" && [[ -n "$dir" ]]; then
    GH_CONFIG_DIR="$dir" command gh "$@"
  else
    command gh "$@"
  fi
}

# Git preflight helpers shared by gcom/grbm/gpum — each prints its own error
# message and returns 1 on failure, so the three callers just chain `|| return 1`.
_git_require_repo() {
  git rev-parse --is-inside-work-tree > /dev/null 2>&1 || {
    echo "Not a git repository."
    return 1
  }
}

_git_require_clean() {
  git diff --quiet HEAD 2>/dev/null || {
    echo "You have uncommitted changes. Commit or stash them first."
    return 1
  }
}

_git_has_origin() {
  git remote | grep -q "^origin$"
}

_git_require_origin() {
  _git_has_origin || {
    echo "No 'origin' remote found."
    return 1
  }
}

_git_current_branch() {
  local branch
  branch=$(git branch --show-current)
  if [[ -z "$branch" ]]; then
    echo "Could not determine current branch."
    return 1
  fi
  echo "$branch"
}

# Prints the repo's default branch (main/master) to stdout. Tries the remote's
# HEAD branch first (only if `origin` exists), falling back to a local `main`
# then `master` ref. Error message goes to stderr so `$(_git_default_branch)`
# command substitution never captures it as the branch name.
_git_default_branch() {
  local default_branch=""
  if _git_has_origin; then
    default_branch=$(git remote show origin 2>/dev/null | awk '/HEAD branch/ { print $NF }')
  fi
  if [[ -z "$default_branch" ]]; then
    if git show-ref --quiet refs/heads/main; then
      default_branch="main"
    elif git show-ref --quiet refs/heads/master; then
      default_branch="master"
    else
      echo "Could not determine default branch." >&2
      return 1
    fi
  fi
  echo "$default_branch"
}

# Switch to default branch (auto-detects main/master)
# Usage: gcom [-p] — pass -p to pull after switching
gcom() {
  local do_pull=0

  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: gcom [-p]"
    echo "  Switch to default branch (main/master). -p to pull after."
    return 0
  fi

  [[ "$1" == "-p" ]] && do_pull=1

  _git_require_repo || return 1
  _git_require_clean || return 1

  # Fetch if remote exists
  _git_has_origin && git fetch origin > /dev/null 2>&1

  local default_branch
  default_branch=$(_git_default_branch) || return 1

  echo "Switching to $default_branch"
  git switch "$default_branch" || return 1

  if [[ $do_pull -eq 1 ]]; then
    echo "Pulling latest..."
    git pull || return 1
  fi
}

# Rebase current branch against default branch
# Usage: grbm
grbm() {
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: grbm"
    echo "  Rebase current branch against default branch (main/master)."
    return 0
  fi

  _git_require_repo || return 1

  local current_branch
  current_branch=$(_git_current_branch) || return 1

  _git_require_clean || return 1
  _git_require_origin || return 1

  git fetch origin > /dev/null 2>&1

  local default_branch
  default_branch=$(_git_default_branch) || return 1

  if [[ "$current_branch" == "$default_branch" ]]; then
    echo "Already on $default_branch. Nothing to rebase."
    return 0
  fi

  echo "Rebasing $current_branch against $default_branch..."
  git rebase "origin/$default_branch"
}

# Push current branch to origin with upstream tracking
# Usage: gpum
gpum() {
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: gpum"
    echo "  Push current branch to origin with -u (upstream tracking)."
    return 0
  fi

  _git_require_repo || return 1

  local current_branch
  current_branch=$(_git_current_branch) || return 1

  _git_require_origin || return 1

  echo "Pushing $current_branch to origin..."
  git push -u origin "$current_branch"
}

# Pretty git log with graph
# Usage: gll [git log options]
gll() {
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: gll [git log options]"
    echo "  Pretty git log with graph, colors, author, and relative dates."
    return 0
  fi

  local fmt='%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(bold white)— %an%C(reset)%C(bold yellow)%d%C(reset)'
  git log --graph --format=format:"$fmt" --abbrev-commit "$@"
}

zfetch() {
  # Terminal colors
  TC='\e['
  Rst="${TC}0m"
  Blk="${TC}30m";
  Red="${TC}31m";
  Grn="${TC}32m";
  Yel="${TC}33m";
  Blu="${TC}34m";
  Prp="${TC}35m";
  Cyn="${TC}36m";
  Wht="${TC}37m";

  git_clone_error_msg() {
      echo -e "  ${Red}[ERROR]${Rst} git clone errored: ${Red}${1}${Rst}. ${Yel}aborting...${Rst}"
  }

  # Simplest dependency fetcher known to mankind
  if [[ $1 == "update" ]]; then
      for name in ${(@k)plugins}; do
          local cwd=$(pwd)
          local dest=$plugins[$name]
          cd "$dest"
          echo -e "Updating ${Yel}${name}${Rst}..."
          git pull --quiet --recurse-submodules
          cd "$cwd"
      done
  elif [[ $1 == "ls" ]]; then
      for name in ${(@k)plugins}; do
          echo -e "${name}: ${Yel}$plugins[$name]${Rst}"
      done
  else

    # the short name of the repo (org/repo)
    local name="$1"

    local plugin_name="${2:-"${name##*/}.plugin.zsh"}"

    # where the repo is going
    local dest="${3:-"$ZPLUGDIR"}"

    # if the dest dir ends with /, append the name to it to get the real dest dir
    if [[ $dest == */ ]]; then
        dest=$dest$name
    else
        dest=$dest/$name
    fi

    local cwd=$(pwd)
    plugins[$name]=$dest

    if [[ ! -d "$dest" ]]; then
        local url="https://github.com/$name.git"
        local ref=$3
        echo -e "Missing plugin ${Yel}${name}${Rst}"
        echo -e "  Cloning from ${Blu}${url}${Rst}..."
        if [[ -n $ref ]]; then
            git clone --quiet "$url" "$dest"
            local rc=$?
            if [[ $rc -ne 0 ]]; then
                git_clone_error_msg "$rc"
                cd "$cwd"
                return "$rc"
            fi

            git checkout --quiet "$ref"
            echo -e "  Checked out branch ${ref}"
        else
            git clone --quiet --depth 1 "$url" "$dest"
            local rc=$?
            if [[ $rc -ne 0 ]]; then
                git_clone_error_msg "$rc"
                cd "$cwd"
                return "$rc"
            fi
            echo -e "  Checked out default branch"
        fi
    fi
    plugin="$dest/$plugin_name"
    if [ -f "$plugin" ]; then
        source "$plugin"
    fi
    cd "$cwd"
  fi
}

########################################################
# Remote Servers
########################################################

# SSH into a host and land inside a persistent tmux session there, creating it
# on first use and re-attaching every time after.
#
# The point is that the shell lives INSIDE tmux ON THE SERVER, so the session
# is not tied to the ssh connection: close the laptop, change wifi, let the
# link time out — the work keeps running and `srv` puts you back exactly where
# you were. The keepalives in ~/.config/ssh/config stop the connection dropping
# in the first place; this is what makes it not matter when it drops anyway.
#
# With no host, falls back to $SRV_HOST — set that in ~/.zshenv.local, which is
# machine-specific and never committed. Deliberately not defaulted to a literal
# alias here: this file is public, and which boxes exist is nobody else's
# business (same rule that keeps the address in ~/.ssh/config.local).
#
# Usage: srv [host] [session]     defaults: $SRV_HOST, main
srv() {
    local host="${1:-${SRV_HOST:-}}" session="${2:-main}"

    if [[ -z "$host" ]]; then
        print -u2 "srv: no host given and \$SRV_HOST is unset"
        print -u2 "     set it in ~/.zshenv.local, e.g. export SRV_HOST=my-server"
        return 1
    fi

    # Pre-flight rather than a confusing "tmux: command not found" after the
    # terminal has already been handed over. Nearly free: ControlMaster means
    # this rides the socket the real connection is about to reuse.
    if ! ssh "$host" 'command -v tmux' >/dev/null 2>&1; then
        print -u2 "srv: no tmux on $host — run: srv-sync $host"
        return 1
    fi

    # -t forces a PTY (ssh would not allocate one for a command), -A attaches to
    # the session if it exists and creates it otherwise, so there is one code
    # path for first connect and reconnect.
    ssh -t "$host" "tmux new-session -A -s ${(q)session}"
}

# Complete srv on the Host aliases defined in either ssh config, skipping
# patterns like `Host *` which are defaults rather than connectable targets.
_srv() {
    local -a hosts
    hosts=(${(f)"$(awk '/^[[:space:]]*[Hh]ost[[:space:]]/ {
                          for (i = 2; i <= NF; i++)
                              if ($i !~ /[*?!]/) print $i
                      }' ~/.ssh/config.local ~/.config/ssh/config 2>/dev/null)"})
    _describe 'host' hosts
}
