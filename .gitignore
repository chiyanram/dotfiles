# Editor / IDE
.idea/
*.swp
*.swo
*~

# Neovim
config/nvim/spell
config/nvim/shada
.netrwhist
lazy-lock.json

# Ghostty
config/ghostty/overrides

# Homebrew
Brewfile.lock.json
brew/*.lock.json

# Plans (ephemeral, not for git)
plan_*.md

# Local-markdown issue staging (durable on disk, never committed;
# graduates to GitHub Issues, then the .scratch copy is deleted)
.scratch/

# Legacy
npm-debug.log

# OS
.DS_Store

# Generated shell state (must never live in the repo tree)
.zcompdump*
*.zwc
.zsh_history
**/ohmyzsh/
.zshrc.pre-oh-my-zsh

# Machine-local config (never committed — secrets / identity live here)
*.local
*-local
# Generated git identity slots — the identities file and per-slot fragments
# (~/.gitconfig-identities, ~/.gitconfig-<slot>) carry client name/email/key path.
.gitconfig-identities
.gitconfig-*

# SSH keys / certs (defense in depth)
id_rsa
id_ed25519
*.pem
*.p12

# Claude Code local state (skills ARE committed; machine state is not)
.claude/settings.local.json
.claude/worktrees/
