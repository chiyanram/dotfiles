# Editor / IDE
.idea/
*.swp
*.swo
*~

# Neovim
config/nvim/spell
config/nvim/shada
.netrwhist
lazy-lock.json

# Ghostty
config/ghostty/overrides

# Homebrew
Brewfile.lock.json
brew/*.lock.json

# Plans (ephemeral, not for git)
plan_*.md

# Local-markdown issue staging (durable on disk, never committed;
# graduates to GitHub Issues, then the .scratch copy is deleted)
.scratch/

# Legacy
npm-debug.log

# OS
.DS_Store

# Generated shell state (must never live in the repo tree)
.zcompdump*
*.zwc
.zsh_history
**/ohmyzsh/
.zshrc.pre-oh-my-zsh

# Machine-local config (never committed — secrets / identity live here)
*.local
*-local
# Generated git identity slots — the identities file and per-slot fragments
# (~/.gitconfig-identities, ~/.gitconfig-<slot>) carry client name/email/key path.
.gitconfig-identities
.gitconfig-*

# SSH keys / certs (defense in depth)
id_rsa
id_ed25519
*.pem
*.p12

# Claude Code local state (only repo-specific skills are committed — #168)
.claude/settings.local.json
.claude/worktrees/
# app rewrites settings.json at runtime (model/effort/theme) — would churn the repo
home/.claude/settings.json
# The `skills` CLI's install artifacts. Generic skills are user-level state and
# live in ~/.claude + ~/.agents; running the CLI with cwd here would otherwise
# drop a duplicate install into the repo and dirty the tree indefinitely (#168).
.agents/
skills-lock.json

# Per-machine identity env (e.g. GH_CONFIG_DIR) — never shared, like .gitconfig-local
.envrc

# Generated by `dot git add-identity`: identity/auth data must never enter version
# control (same rule as .gitconfig-local). Lands here because ~/.config/git is
# symlinked to this directory — it is NOT a config/git/config identity leak, just
# where the symlink happens to put it.
config/git/allowed_signers
